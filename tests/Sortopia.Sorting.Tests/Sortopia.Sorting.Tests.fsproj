<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Samples.fs" />
    <Compile Include="CeTests.fs" />
    <Compile Include="SorterTests.fs" />
    <Compile Include="SorterSetTests.fs" />
    <Compile Include="SortableIntArrayTests.fs" />
    <Compile Include="StageSequenceTests.fs" />
    <Compile Include="Tests.fs" />
    <Compile Include="InvariantTests.fs" />
    <Compile Include="HistoryTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sortopia.Sorting\Sortopia.Sorting.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FsUnit.xUnit" Version="8.0.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
</Project>

