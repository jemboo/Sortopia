<UserControl x:Class="Sortopia.WPF.Views.Pages.Sgd.SgdPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sgdVm="clr-namespace:Sortopia.WPF.ViewModels.Pages.Sgd"
             xmlns:subPages="clr-namespace:Sortopia.WPF.Views.Pages.Sgd.SubPages"
             xmlns:subPageVm="clr-namespace:Sortopia.WPF.ViewModels.Pages.Sgd.SubPages"
             Foreground="{DynamicResource Workspace.TextPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AutomationProperties.Name="Sgd Page">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sortopia.WPF;component/Styles/SgdWorkspace.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{StaticResource Workspace.Canvas}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="12,0,0,0">
                    <Button Content="← _Back to Sortopia" Command="{Binding ReturnHomeCommand}" Style="{StaticResource PageReturnButtonStyle}" />
                </Viewbox>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <WrapPanel x:Name="WizardSteps" AutomationProperties.Name="Wizard steps" ItemHeight="{StaticResource SetupSamplingControlHeight}">
                        <Button Content="1  Setup" Command="{Binding SetupStepCommand}" AutomationProperties.Name="Step 1: Setup">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource StepNavigationButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static sgdVm:SgdStep.Setup}">
                                            <Setter Property="BorderBrush" Value="{StaticResource Workspace.Accent}" />
                                            <Setter Property="Background" Value="{StaticResource Workspace.SurfaceSelected}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="2  Sampling" Command="{Binding SamplingStepCommand}" AutomationProperties.Name="Step 2: Sampling">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource StepNavigationButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static sgdVm:SgdStep.Sampling}">
                                            <Setter Property="BorderBrush" Value="{StaticResource Workspace.Accent}" />
                                            <Setter Property="Background" Value="{StaticResource Workspace.SurfaceSelected}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="3  Evolution" Command="{Binding EvolutionStepCommand}" AutomationProperties.Name="Step 3: Evolution">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource StepNavigationButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static sgdVm:SgdStep.Evolution}">
                                            <Setter Property="BorderBrush" Value="{StaticResource Workspace.Accent}" />
                                            <Setter Property="Background" Value="{StaticResource Workspace.SurfaceSelected}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </Viewbox>
            </Grid>
            <ContentControl x:Name="StepContent" Grid.Row="1" Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type subPageVm:SgdSetupPageViewModel}">
                        <subPages:SgdSetupPage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type subPageVm:SgdSamplingPageViewModel}">
                        <subPages:SgdSamplingPage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type subPageVm:SgdEvolutionPageViewModel}">
                        <subPages:SgdEvolutionPage />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Border>
</UserControl>
