<UserControl x:Class="Sortopia.WPF.Views.Pages.Sgd.SubPages.SgdEvolutionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sortopia.WPF.Views.Shared.Controls"
             Foreground="{DynamicResource Workspace.TextPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AutomationProperties.Name="Sgd Evolution Page">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sortopia.WPF;component/Styles/SgdWorkspace.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.1*" MinHeight="45" />
            <RowDefinition Height="8" />
            <RowDefinition Height="2.45*" MinHeight="165" />
        </Grid.RowDefinitions>
        <Grid x:Name="SettingsArea" Grid.Row="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowResultPanes}" Value="False">
                            <Setter Property="Grid.RowSpan" Value="3" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource ControlGroup}">
                <Grid Margin="2,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox x:Name="SettingsViewport" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel AutomationProperties.Name="Evolution settings">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} Channels · {1}">
                                            <Binding Path="Network.Width" />
                                            <Binding Path="Mutation.Method" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <Grid x:Name="EvolutionRateControls" Width="340" MaxWidth="{Binding ActualWidth, ElementName=EvolutionOptions}" HorizontalAlignment="Left" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Target="{Binding ElementName=EvolutionSpeedSlider}" Style="{StaticResource FieldLabel}">
                                        <TextBlock Text="Evolution speed" TextWrapping="Wrap" />
                                    </Label>
                                    <Label Grid.Column="2" Target="{Binding ElementName=ModificationRateSlider}" Style="{StaticResource FieldLabel}">
                                        <TextBlock Text="Overall modification rate" TextWrapping="Wrap" />
                                    </Label>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="EvolutionSpeedSlider" Minimum="0" Maximum="500" TickFrequency="10" SmallChange="10" LargeChange="50" IsSnapToTickEnabled="True" Value="{Binding GenerationMilliseconds}" VerticalAlignment="Center" AutomationProperties.Name="SGD generation speed" ToolTip="{Binding SpeedLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding GenerationMilliseconds, StringFormat='{}{0} ms'}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="2" IsEnabled="{Binding CanChooseMutation}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="ModificationRateSlider" Minimum="-3" Maximum="0" SmallChange="0.01" LargeChange="0.1" Value="{Binding Mutation.OverallRate.LogValue, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Overall modification rate" ToolTip="Logarithmic scale from 0.001 to 1." />
                                        <TextBlock Grid.Column="1" Text="{Binding Mutation.OverallRate.Value, StringFormat=G3}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                                <WrapPanel x:Name="EvolutionOptions" HorizontalAlignment="Left" Margin="0,0,0,4">
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Variant" Target="{Binding ElementName=VariantPicker}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="VariantPicker" Width="57" ItemsSource="{Binding Mutation.Variants}" SelectedItem="{Binding Mutation.Variant}" IsEnabled="{Binding CanChooseMutation}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Children / generation" Target="{Binding ElementName=ChildrenPicker}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ChildrenPicker" Width="57" ItemsSource="{Binding ChildChoices}" SelectedItem="{Binding Children}" ToolTip="Children per generation" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,3" IsEnabled="{Binding CanChooseMutation}" Visibility="{Binding Mutation.HasMultipleTables, Converter={StaticResource BoolVisibility}}">
                                        <Label Content="Parameter table" Target="{Binding ElementName=MutationTablePicker}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="MutationTablePicker" ItemsSource="{Binding Mutation.ParameterTables}" DisplayMemberPath="Name" SelectedItem="{Binding Mutation.SelectedTable}" Width="130" AutomationProperties.Name="Mutation parameter table" />
                                    </StackPanel>
                                    <CheckBox Content="Exclude self CEs" IsChecked="{Binding Mutation.ExcludeSelf}" IsEnabled="{Binding CanChooseMutation}" VerticalAlignment="Center" Margin="0,10,0,0" Visibility="{Binding Mutation.CanExcludeSelf, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource Workspace.TextPrimary}" />
                                </WrapPanel>
                                <StackPanel IsEnabled="{Binding CanChooseMutation}">
                                    <controls:ParamEditor2d x:Name="MutationEditor" DataContext="{Binding Mutation.SelectedTable.Parameters}" Margin="0,0,0,5" AutomationProperties.Name="Mutation parameters" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Viewbox>
                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Workspace.Stroke}" Padding="10,0,0,0">
                        <Viewbox x:Name="OutputViewport" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel Width="320">
                                <StackPanel AutomationProperties.Name="Evolution output">
                                    <WrapPanel Margin="0,0,0,4">
                                        <Button Style="{StaticResource PrimaryAction}" Content="Run SGD" Command="{Binding RunSgdCommand}" Margin="0,0,4,3" />
                                        <Button Style="{StaticResource StopAction}" Content="Stop" Command="{Binding StopCommand}" Margin="0,0,0,3" />
                                    </WrapPanel>
                                    <TextBlock Text="Latest evaluation" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Generation" Content="{Binding Generation, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Sorter identities" Content="{Binding SorterUniqueness}" ToolTip="This SGD run: unique stage-packed sorter fingerprints and repeat evaluations. The initial parent is included. Fingerprints use the tested network after unused CEs are removed." />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Failures" Content="{Binding PlottedFailures, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Test inputs" Content="{Binding Usage.Tested, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Coverage" Content="{Binding Usage.Coverage, TargetNullValue=—, FallbackValue=—}" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Stages" Content="{Binding Visits.Current.Y, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Comparators" Content="{Binding Visits.Current.X, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource InlineError}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Visibility="{Binding ShowResultPanes, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Workspace.StrokeSubtle}" Cursor="SizeNS" AutomationProperties.Name="Resize settings and network panes" />
        <controls:SgdResultsView x:Name="Results" Grid.Row="2" Visibility="{Binding ShowResultPanes, Converter={StaticResource BoolVisibility}}" />
    </Grid>
</UserControl>