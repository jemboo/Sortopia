<UserControl x:Class="Sortopia.WPF.Views.Pages.Sgd.SubPages.SgdSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Workspace.TextPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AutomationProperties.Name="Sgd Setup Page">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sortopia.WPF;component/Styles/SgdWorkspace.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid VerticalAlignment="Top">
        <Grid x:Name="SettingsArea" Grid.Row="0" IsEnabled="{Binding CanEdit}">
            <Border Style="{StaticResource ControlGroup}">
                <Grid Margin="2,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox x:Name="SettingsViewport" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel AutomationProperties.Name="Shared settings">
                                <TextBlock Text="Configure a run" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Method" Target="{Binding ElementName=MethodPicker}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="MethodPicker" Width="96" Height="{StaticResource SetupSamplingControlHeight}" ItemsSource="{Binding Generator.Methods}" SelectedItem="{Binding Generator.Method}" AutomationProperties.Name="Generation method" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Channels" Target="{Binding ElementName=ChannelPicker}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ChannelPicker" Width="72" Height="{StaticResource SetupSamplingControlHeight}" ItemsSource="{Binding Generator.ChannelCounts}" SelectedItem="{Binding Generator.ChannelCount, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False" ToolTip="{Binding Generator.WidthHint}" AutomationProperties.Name="Channel count" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Stages" Target="{Binding ElementName=StagesInput}" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="StagesInput" Width="86" Height="{StaticResource SetupSamplingControlHeight}" Text="{Binding Generator.CountText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter 1–10,000 stages to override the default for this setup. For msce this sets the equivalent comparator budget." />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Test inputs / all" Target="{Binding ElementName=SampleInput}" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SampleInput" Width="100" Height="{StaticResource SetupSamplingControlHeight}" Text="{Binding Generator.SamplesText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Generator.TestHint}" />
                                    </StackPanel>
                                </WrapPanel>
                                <CheckBox x:Name="Avx512Picker" Content="AVX512" Foreground="{StaticResource Workspace.TextPrimary}" Margin="0,3" Height="{StaticResource SetupSamplingControlHeight}" VerticalContentAlignment="Center" IsChecked="{Binding UseAvx512}" IsEnabled="{Binding CanChooseAvx512}" ToolTip="{Binding Avx512Hint}" ToolTipService.ShowOnDisabled="True" />
                            </StackPanel>
                        </StackPanel>
                    </Viewbox>
                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Workspace.Stroke}" Padding="10,0,0,0">
                        <Viewbox x:Name="OutputViewport" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel Width="320">
                                <StackPanel AutomationProperties.Name="Test plan">
                                    <TextBlock Text="Evaluation plan" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="99% stage default" Content="{Binding Generator.StageDefaultDescription}" ToolTip="GeneSort stage count for 99% sorter success. Estimates use the nearest measured widths for this method." />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Coverage" Content="{Binding PlannedCoverage, TargetNullValue=—, FallbackValue=—}" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Inputs before prefix" Content="{Binding PlannedInputs, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" ToolTip="A prefix chosen on Sampling reduces this set to distinct outputs. Sampling shows the actual test count." />
                                    <TextBlock Text="{Binding Generator.SetupError}" Style="{StaticResource InlineError}" />
                                    <TextBlock Text="{Binding Generator.TestInputError}" Style="{StaticResource InlineError}" />
                                    <Button Content="Continue to sampling →" Command="{Binding ContinueCommand}" Style="{StaticResource PrimaryAction}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
