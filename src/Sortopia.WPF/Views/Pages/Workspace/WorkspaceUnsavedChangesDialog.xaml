<Window x:Class="Sortopia.WPF.Views.Pages.Workspace.WorkspaceUnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved Workspace changes" Width="470" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Workspace.Canvas}" Foreground="{DynamicResource Workspace.TextPrimary}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Save Workspace changes?" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="This workspace has unsaved changes. Save them before continuing, discard them, or cancel to keep editing."
                   TextWrapping="Wrap" Margin="0,12,0,20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveChangesButton" Content="Save" IsDefault="True" Click="OnSave" MinWidth="85" Margin="0,0,8,0" />
            <Button x:Name="DiscardChangesButton" Content="Discard" Click="OnDiscard" MinWidth="85" Margin="0,0,8,0" />
            <Button x:Name="CancelChangesButton" Content="Cancel" IsCancel="True" MinWidth="85" />
        </StackPanel>
    </StackPanel>
</Window>
