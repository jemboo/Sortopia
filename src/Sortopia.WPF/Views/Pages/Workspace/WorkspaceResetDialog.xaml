<Window x:Class="Sortopia.WPF.Views.Pages.Workspace.WorkspaceResetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset generated files" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Workspace.Canvas}" Foreground="{DynamicResource Workspace.TextPrimary}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Reset generated files?" FontSize="20" FontWeight="SemiBold" />
        <TextBox x:Name="ResetPath" Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,12,0,12"
                 Background="Transparent" Foreground="{DynamicResource Workspace.TextPrimary}" BorderThickness="0" Padding="0"
                 AutomationProperties.Name="Selected workspace path" />
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Text="{Binding EditingNotice}" TextWrapping="Wrap" Margin="0,0,0,20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelResetButton" Content="Cancel" IsDefault="True" IsCancel="True" MinWidth="85" Margin="0,0,8,0" />
            <Button x:Name="ConfirmResetButton" Content="Reset generated files" Click="OnReset" MinWidth="155" />
        </StackPanel>
    </StackPanel>
</Window>
