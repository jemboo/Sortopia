<UserControl x:Class="Sortopia.WPF.Views.Pages.Workspace.WorkspaceOverrideEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sortopia.WPF.Views.Pages.Workspace">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" />
    </ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="VisibleWhen" /></ResourceDictionary></UserControl.Resources>
    <StackPanel Margin="0,0,0,14">
        <Label Content="{Binding Title}" Padding="0,0,0,4" Foreground="{DynamicResource Workspace.TextPrimary}" FontWeight="SemiBold">
            <Label.Style><Style TargetType="Label">
                <Setter Property="Target" Value="{Binding ElementName=OverrideValueInput}" />
                <Style.Triggers><DataTrigger Binding="{Binding ShowCatalogPicker}" Value="True"><Setter Property="Target" Value="{Binding ElementName=FunctionNameInput}" /></DataTrigger></Style.Triggers>
            </Style></Label.Style>
        </Label>
        <CheckBox x:Name="OverrideToggle" Content="{Binding OverrideCaption}" IsChecked="{Binding IsOverridden}" MinHeight="28"
                  Visibility="{Binding ShowOverrideToggle, Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding CanOverride}" ToolTip="{Binding DefinitionHint}" ToolTipService.ShowOnDisabled="True"
                  Foreground="{DynamicResource Workspace.TextPrimary}" AutomationProperties.Name="{Binding OverrideAutomationName}" />
        <TextBox x:Name="OverrideValueInput" Text="{Binding EffectiveValue, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ShowPreview}"
                 AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxHeight="140"
                 AutomationProperties.Name="{Binding Title}">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource NetworkTextBoxStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowCatalogPicker}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsMultiline}" Value="True"><Setter Property="MinHeight" Value="70" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsInherited}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <local:FunctionNameSelector x:Name="FunctionNameInput" Choices="{Binding Choices}" SelectedFunction="{Binding EffectiveValue, Mode=TwoWay}"
                                    IsSetupCatalog="{Binding IsSetupCatalog}"
                                    IsEnabled="{Binding CanSelectValue}"
                                    Visibility="{Binding ShowCatalogPicker, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding Title}" />
        <local:WorkspaceValueSource x:Name="ValueSource" />
        <StackPanel Margin="0,4,0,0" Visibility="{Binding HasDescendantFunctionDefinitions, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Defined in descendant modules:" TextWrapping="Wrap" Foreground="{DynamicResource Workspace.TextSecondary}" FontSize="12" />
            <ItemsControl x:Name="DescendantFunctionLinks" ItemsSource="{Binding DescendantFunctionDefinitions}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12">
                        <Hyperlink x:Name="DescendantFunctionLink" Foreground="{DynamicResource Workspace.Accent}"
                                   Command="{Binding DataContext.SelectValueSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspacePage}}}"
                                   CommandParameter="{Binding Module}" ToolTip="{Binding FunctionName}"
                                   AutomationProperties.Name="{Binding Path, StringFormat=Function defined on {0}}">
                            <Run Text="{Binding Path, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <Button x:Name="UseInheritedFunctionButton" Content="{Binding ClearFunctionDefinitionCaption}" Command="{Binding UseInheritedFunctionCommand}"
                HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding CanClearFunctionDefinition, Converter={StaticResource VisibleWhen}}"
                ToolTip="{Binding ClearFunctionDefinitionHint}" />
        <TextBlock Text="{Binding Error}" Style="{StaticResource InlineError}" Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
