<UserControl x:Class="Sortopia.WPF.Views.Pages.Workspace.WorkspacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sortopia.WPF.ViewModels.Pages.Workspace"
             xmlns:local="clr-namespace:Sortopia.WPF.Views.Pages.Workspace"
             FontFamily="Segoe UI" UseLayoutRounding="True"
             AutomationProperties.Name="Workspace page" Foreground="{DynamicResource Workspace.TextPrimary}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="WorkspaceBoolVisibility" />
            <HierarchicalDataTemplate DataType="{x:Type vm:WorkspaceTreeNode}" ItemsSource="{Binding Children}">
                <Border Padding="3" CornerRadius="3" ToolTip="{Binding DiskStatusDetail}" AutomationProperties.ItemStatus="{Binding DiskStatus}">
                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource Workspace.Primary}" /></DataTrigger><DataTrigger Binding="{Binding IsCut}" Value="True"><Setter Property="Opacity" Value="0.5" /></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding KindLabel}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Workspace.Accent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBranch}" Value="True"><Setter Property="Foreground" Value="#D8B4FE" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsWorkspace}" Value="True"><Setter Property="Foreground" Value="{StaticResource Workspace.TextSecondary}" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger>
                            </Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Workspace.TextPrimary}" />
                    <TextBlock Text="Cut" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Workspace.TextSecondary}"
                               Visibility="{Binding IsCut, Converter={StaticResource WorkspaceBoolVisibility}}" />
                    <TextBlock Text="{Binding DiskStatus}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Workspace.TextSecondary}" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                    <DataTrigger Binding="{Binding HasDiskWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Workspace.Warning}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </StackPanel>
                </Border>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="WorkspaceViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16" Background="{StaticResource Workspace.Canvas}">
    <Grid MinHeight="640" Height="{Binding ViewportHeight, ElementName=WorkspaceViewport}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="← _Back to Sortopia" Command="{Binding ReturnHomeCommand}"
                    Style="{StaticResource PageReturnButtonStyle}" Margin="16,0,0,0" AutomationProperties.Name="Back to Sortopia" />
            <TextBlock Text="Workspace" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="WorkspaceFolderPath" Text="{Binding WorkspaceFolder, Mode=OneWay}" IsReadOnly="True"
                         MinHeight="32" VerticalContentAlignment="Center" ToolTip="{Binding WorkspaceFolder}" AutomationProperties.Name="Workspace folder" />
                <Button Grid.Column="1" Content="_Browse…" Command="{Binding BrowseWorkspaceFolderCommand}"
                        MinHeight="32" MinWidth="90" Margin="8,0,0,0" AutomationProperties.Name="Browse for Workspace folder" />
            </Grid>
            <TextBlock x:Name="WorkspaceFileStatus" Text="{Binding WorkspaceFileStatus}" Margin="0,8,0,0"
                       TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="MissingComponentsNotice" Text="{Binding MissingComponentsMessage}" Margin="0,4,0,0"
                       TextWrapping="Wrap" Foreground="{StaticResource Workspace.Warning}" AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding HasMissingComponents, Converter={StaticResource WorkspaceBoolVisibility}}" />
            <StackPanel x:Name="WorkspaceNamePanel" Visibility="{Binding ShowWorkspaceEditor, Converter={StaticResource WorkspaceBoolVisibility}}"
                        Margin="0,8,0,0" IsEnabled="{Binding CanEdit}">
                <Label Content="Workspace _name" Target="{Binding ElementName=WorkspaceNameInput}" Padding="0,0,0,4" Foreground="{StaticResource Workspace.TextPrimary}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="WorkspaceNameInput" Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}" MinHeight="32"
                             VerticalContentAlignment="Center" AutomationProperties.Name="Workspace name" />
                    <Button x:Name="SaveWorkspaceButton" Grid.Column="1" Content="Save workspace" Command="{Binding SaveWorkspaceCommand}"
                            Style="{StaticResource PrimaryAction}" Margin="8,0,0,0" AutomationProperties.Name="Save workspace" />
                    <Button x:Name="DiscardChangesButton" Grid.Column="2" Content="Discard changes" Command="{Binding DiscardChangesCommand}"
                            Margin="8,0,0,0" ToolTip="Restore the last saved workspace and cancel pending imports. No files are changed." />
                </Grid>
                <TextBlock Text="{Binding WorkspaceNameError}" Style="{StaticResource InlineError}" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2" IsEnabled="{Binding CanEdit}" Visibility="{Binding ShowWorkspaceEditor, Converter={StaticResource WorkspaceBoolVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="170" /><ColumnDefinition Width="3*" MinWidth="190" /></Grid.ColumnDefinitions>
                <WrapPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Button x:Name="NewRootModuleButton" Content="New root module" Command="{Binding AddModuleCommand}" Margin="0,0,4,4" Visibility="{Binding ShowRootModuleAction, Converter={StaticResource WorkspaceBoolVisibility}}" ToolTip="Contains root projects and runs without setup." />
                    <Button x:Name="NewBranchModuleButton" Content="New branch module" Command="{Binding AddBranchModuleCommand}" Margin="0,0,4,4" Visibility="{Binding ShowBranchModuleAction, Converter={StaticResource WorkspaceBoolVisibility}}" ToolTip="Contains branch projects and runs with setup and execution." />
                    <Button x:Name="NewProjectButton" Content="{Binding AddProjectLabel}" Visibility="{Binding ShowProjectAction, Converter={StaticResource WorkspaceBoolVisibility}}" Command="{Binding AddProjectCommand}" Margin="0,0,4,4" />
                    <Button x:Name="NewRunButton" Content="{Binding AddRunLabel}" Visibility="{Binding ShowRunAction, Converter={StaticResource WorkspaceBoolVisibility}}" Command="{Binding AddRunCommand}" Margin="0,0,4,4" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Button x:Name="AddExistingModuleButton" Content="Add module…" Command="{Binding AddExistingModuleCommand}" Margin="0,0,4,4"
                            ToolTip="Choose a module folder anywhere on disk. Saving copies it and all contents into the selected parent's modules container." />
                    <Button x:Name="AddExistingProjectButton" Content="Add project…" Command="{Binding AddExistingProjectCommand}" Margin="0,0,4,4"
                            ToolTip="Choose a project folder anywhere on disk. Saving copies it and all contents into the selected parent's projects container." />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Button x:Name="CutEntityButton" Content="Cut" Command="{Binding CutCommand}" Margin="0,0,4,4" ToolTip="Cut the selected entity (Ctrl+X in the tree). Files move when saved." />
                    <Button x:Name="PasteEntityButton" Content="Paste" Command="{Binding PasteCommand}" Margin="0,0,4,4" ToolTip="{Binding PasteHint}" ToolTipService.ShowOnDisabled="True" />
                    <Button Content="Cancel cut" Command="{Binding CancelCutCommand}" Margin="0,0,4,4"
                            Visibility="{Binding HasCutItem, Converter={StaticResource WorkspaceBoolVisibility}}" />
                  </StackPanel>
                    <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="0,0,0,4"
                            ToolTip="Remove the selected entity from the workspace. Existing folders and files are kept." />
                </WrapPanel>
                <TextBlock x:Name="SelectionHint" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SelectionHint}" Foreground="{StaticResource Workspace.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TreeView x:Name="WorkspaceTree" Grid.Row="2" Margin="0,0,8,0" ItemsSource="{Binding Roots}" SelectedItemChanged="OnSelectedItemChanged" PreviewMouseRightButtonDown="OnTreeRightClick"
                          Background="{StaticResource Workspace.Surface}" Foreground="{StaticResource Workspace.TextPrimary}"
                          BorderBrush="{StaticResource Workspace.StrokeSubtle}" AutomationProperties.Name="Workspace hierarchy">
                    <TreeView.InputBindings>
                        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}" />
                        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CancelCutCommand}" />
                    </TreeView.InputBindings>
                    <TreeView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                            <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                            <MenuItem Header="Cancel cut" Command="{Binding CancelCutCommand}" InputGestureText="Esc" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="{StaticResource Workspace.TextPrimary}" />
                            <Setter Property="IsExpanded" Value="True" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            <Border x:Name="EntityDetailsPanel" Grid.Row="2" Grid.Column="1" Background="{StaticResource Workspace.Surface}" BorderBrush="{StaticResource Workspace.StrokeSubtle}" BorderThickness="1" Padding="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Selected.IsWorkspace}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer x:Name="EntityInspectorViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel DataContext="{Binding Selected}">
                    <TextBlock Text="{Binding KindLabel, TargetNullValue=Select an entity}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel>
                        <TextBox x:Name="EntityNameInput" IsEnabled="{Binding CanEditIdentity}" Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" AutomationProperties.Name="Entity name" />
                        <TextBlock x:Name="EntityNameError" Text="{Binding NameError}" Style="{StaticResource InlineError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <Button Content="Edit parent defaults" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Visibility="{Binding HasParentDefaults, Converter={StaticResource WorkspaceBoolVisibility}}"
                            Command="{Binding DataContext.EditProjectDefaultsCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspacePage}}}" />
                    <Expander x:Name="RunExecutionExpander" Header="Execution" IsExpanded="True" Margin="0,12,0,0"
                              Foreground="{StaticResource Workspace.TextPrimary}"
                              Visibility="{Binding IsRun, Converter={StaticResource WorkspaceBoolVisibility}}">
                        <StackPanel Margin="0,8,0,8" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspacePage}}}">
                            <Button x:Name="ExecuteRunButton" Content="Execute" Command="{Binding ExecuteRunCommand}" HorizontalAlignment="Left" MinWidth="100"
                                    AutomationProperties.Name="Execute run" ToolTip="Execute every generated parameter set using the saved run settings." />
                            <TextBlock Text="{Binding ExecuteHint}" TextWrapping="Wrap" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,6,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,4,0,8"
                                       Text="{Binding ExecutionInstructions}" />
                            <StackPanel DataContext="{Binding SelectedExecution}">
                                <TextBlock x:Name="RunExecutionSummary" Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,4,0,0" />
                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}" Height="6" Margin="0,8,0,4"
                                             Visibility="{Binding IsRunning, Converter={StaticResource WorkspaceBoolVisibility}}" AutomationProperties.Name="Run execution progress" />
                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Style="{StaticResource InlineError}" />
                                <Expander x:Name="RunOutputsExpander" Header="Completed calls and output summaries" Margin="0,8,0,0" Foreground="{StaticResource Workspace.TextPrimary}"
                                          Visibility="{Binding HasReport, Converter={StaticResource WorkspaceBoolVisibility}}">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="{Binding RowsHint}" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border BorderBrush="{StaticResource Workspace.StrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Workspace.TextPrimary}" />
                                                        <TextBlock Text="{Binding Parameters}" TextWrapping="Wrap" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Outputs}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource Workspace.TextPrimary}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            <TextBlock Text="Outputs stay in memory while this workspace is open. Database saving and source-project data loading are not connected yet."
                                       TextWrapping="Wrap" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>
                    <StackPanel Visibility="{Binding HasConfiguration, Converter={StaticResource WorkspaceBoolVisibility}}">
                        <TextBlock Text="{Binding ProjectState}" TextWrapping="Wrap" Margin="0,8,0,4" Foreground="{DynamicResource Workspace.Accent}" />
                        <Button Content="Create new version" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding IsSealed, Converter={StaticResource WorkspaceBoolVisibility}}"
                                Command="{Binding DataContext.CreateProjectVersionCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspacePage}}}" />
                        <local:WorkspaceConfigurationEditor x:Name="ConfigurationFields" DataContext="{Binding Editor}" />
                    </StackPanel>
                    <Expander x:Name="EntityLocationExpander" Header="Location" Margin="0,16,0,0" Foreground="{StaticResource Workspace.TextSecondary}">
                        <Expander.Style><Style TargetType="Expander"><Style.Triggers>
                            <DataTrigger Binding="{Binding HasConfiguration}" Value="False"><Setter Property="IsExpanded" Value="True" /></DataTrigger>
                        </Style.Triggers></Style></Expander.Style>
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel x:Name="EntityFolderNamePanel" Visibility="{Binding HasFolder, Converter={StaticResource WorkspaceBoolVisibility}}">
                        <Label Content="Folder name" Target="{Binding ElementName=EntityFolderNameInput}" Padding="0,0,0,4" Foreground="{StaticResource Workspace.TextPrimary}" />
                        <TextBox x:Name="EntityFolderNameInput" IsEnabled="{Binding CanEditIdentity}" Text="{Binding FolderNameInput, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsWorkspace}"
                                 MinHeight="30" AutomationProperties.Name="Entity folder name" />
                        <TextBlock x:Name="EntityFolderNameError" Text="{Binding FolderNameError}" Style="{StaticResource InlineError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Workspace.TextSecondary}"
                                   Text="{Binding FolderNameHint}" />
                        </StackPanel>
                        <Label Content="Full path" Target="{Binding ElementName=EntityFullPath}" Padding="0,10,0,4" Foreground="{StaticResource Workspace.TextPrimary}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="EntityFullPath" IsReadOnly="True" TextWrapping="Wrap" MinHeight="30" MaxHeight="76" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding DataContext.SelectedFolderPath, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=OneWay}"
                                     ToolTip="Entity location in the current workspace tree. Pending changes take effect when saved."
                                     AutomationProperties.Name="Selected entity full path" />
                            <Button x:Name="OpenEntityFolderButton" Grid.Column="1" Content="Open folder" Margin="8,0,0,0" VerticalAlignment="Top" MinHeight="30"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    ToolTip="Open this folder in File Explorer. Available when the folder exists on disk."
                                    AutomationProperties.Name="Open selected folder in File Explorer" />
                        </Grid>
                        <TextBlock x:Name="PendingCopyNotice" Text="{Binding PendingCopyDescription}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource Workspace.TextSecondary}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding DiskStatusDetail}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource Workspace.Warning}"
                                   Visibility="{Binding HasDiskWarning, Converter={StaticResource WorkspaceBoolVisibility}}" />
                    </StackPanel>

                    </Expander>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <Expander x:Name="RetainedFoldersNotice" Header="Files and folders kept outside this workspace" Margin="0,0,0,6"
                      Foreground="{StaticResource Workspace.TextSecondary}"
                      Visibility="{Binding HasRetainedFolders, Converter={StaticResource WorkspaceBoolVisibility}}">
                <ListBox ItemsSource="{Binding RetainedFolders}" MaxHeight="100" Margin="0,6,0,0"
                         Background="{StaticResource Workspace.Surface}" Foreground="{StaticResource Workspace.TextPrimary}"
                         BorderBrush="{StaticResource Workspace.StrokeSubtle}" AutomationProperties.Name="Retained folders" />
            </Expander>
            <DockPanel>
                <Button Content="Cancel operation" Command="{Binding CancelCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource WorkspaceBoolVisibility}}" />
                <StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Workspace.TextSecondary}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Style="{StaticResource InlineError}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
