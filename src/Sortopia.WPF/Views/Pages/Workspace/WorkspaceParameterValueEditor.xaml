<UserControl x:Class="Sortopia.WPF.Views.Pages.Workspace.WorkspaceParameterValueEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" /></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhen" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBox x:Name="TypedValueInput" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap" MaxHeight="100"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="{Binding Hint}"
                 Visibility="{Binding IsTextEditor, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Parameter value">
            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource NetworkTextBoxStyle}">
                <Style.Triggers><DataTrigger Binding="{Binding IsNumeric}" Value="True"><Setter Property="InputScope" Value="Number" /></DataTrigger></Style.Triggers>
            </Style></TextBox.Style>
        </TextBox>
        <ComboBox x:Name="BooleanValueInput" ItemsSource="{Binding BooleanChoices}" SelectedItem="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Visibility="{Binding IsBoolean, Converter={StaticResource VisibleWhen}}" ToolTip="Choose True or False" AutomationProperties.Name="Boolean parameter value" />
        <ComboBox x:Name="ChoiceValueInput" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="240"
                  SelectionChanged="OnChoiceSelectionChanged" ToolTip="{Binding Hint}"
                  Visibility="{Binding HasChoices, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Parameter value choice">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="440" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel x:Name="LibraryIdFields" Visibility="{Binding IsLibraryId, Converter={StaticResource VisibleWhen}}">
            <StackPanel DataContext="{Binding LibraryId}">
                <Label Content="Catalog entry" Target="{Binding ElementName=LibraryCatalogInput}" Padding="0,0,0,4" Foreground="{DynamicResource Workspace.TextPrimary}" />
                <ComboBox x:Name="LibraryCatalogInput" ItemsSource="{Binding CatalogChoices}" SelectedItem="{Binding SelectedCatalogId, Mode=TwoWay}" MaxDropDownHeight="260" AutomationProperties.Name="Library catalog entry">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="420" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding CatalogHint}" TextWrapping="Wrap" Foreground="{DynamicResource Workspace.TextSecondary}" FontSize="12" Margin="0,6,0,8" />
                <Label Content="Channel count" Target="{Binding ElementName=LibraryChannelCountInput}" Padding="0,6,0,4" Foreground="{DynamicResource Workspace.TextPrimary}" />
                <TextBox x:Name="LibraryChannelCountInput" Text="{Binding ChannelCount, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" AutomationProperties.Name="Library channel count" />
                <StackPanel Visibility="{Binding IsPrefix, Converter={StaticResource VisibleWhen}}">
                    <Label Content="Stage length" Target="{Binding ElementName=LibraryStageLengthInput}" Padding="0,6,0,4" Foreground="{DynamicResource Workspace.TextPrimary}" />
                    <TextBox x:Name="LibraryStageLengthInput" Text="{Binding StageLength, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" AutomationProperties.Name="Prefix stage length" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsMerge, Converter={StaticResource VisibleWhen}}">
                    <Label Content="Merge dimension" Target="{Binding ElementName=LibraryMergeDimensionInput}" Padding="0,6,0,4" Foreground="{DynamicResource Workspace.TextPrimary}" />
                    <TextBox x:Name="LibraryMergeDimensionInput" Text="{Binding MergeDimension, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" AutomationProperties.Name="Merge dimension" />
                </StackPanel>
                <Label Content="Variant" Target="{Binding ElementName=LibraryVariantInput}" Padding="0,6,0,4" Foreground="{DynamicResource Workspace.TextPrimary}" />
                <ComboBox x:Name="LibraryVariantInput" ItemsSource="{Binding Variants}" SelectedItem="{Binding Variant, Mode=TwoWay}" AutomationProperties.Name="Library variant" />
                <TextBlock Text="Identifier" Margin="0,6,0,4" />
                <TextBox Text="{Binding Identifier, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Library identifier" />
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="GenerationWeightFields" Visibility="{Binding IsWeights, Converter={StaticResource VisibleWhen}}">
            <StackPanel DataContext="{Binding Weights}">
                <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="{DynamicResource Workspace.TextSecondary}" FontSize="12" Margin="0,4,0,8" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Modes}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Width="100" Margin="0,0,8,4">
                                        <Label Content="{Binding Name}" Target="{Binding ElementName=ModeWeightInput}" Padding="0,0,0,3" />
                                        <TextBox x:Name="ModeWeightInput" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" AutomationProperties.Name="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Visibility="{Binding IsUnfolding, Converter={StaticResource VisibleWhen}}">
                    <Button Content="Add unfolding level" Command="{Binding AddLevelCommand}" Margin="0,0,8,4" />
                    <Button Content="Remove last level" Command="{Binding RemoveLevelCommand}" Margin="0,0,0,4" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding Error}" Style="{StaticResource InlineError}" Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
