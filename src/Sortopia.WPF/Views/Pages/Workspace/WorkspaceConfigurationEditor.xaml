<UserControl x:Class="Sortopia.WPF.Views.Pages.Workspace.WorkspaceConfigurationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sortopia.WPF.Views.Pages.Workspace"
             Foreground="{DynamicResource Workspace.TextPrimary}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Workspace.TextPrimary}" />
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Workspace.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,4,0,6" />
        </Style>
        <Style x:Key="Inherited" TargetType="TextBlock" BasedOn="{StaticResource Help}">
            <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
        </Style>
        <DataTemplate x:Key="OutputChoice">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" MinHeight="28" Foreground="{DynamicResource Workspace.TextPrimary}" />
        </DataTemplate>
        <DataTemplate x:Key="QueryKey">
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="×" Command="{Binding RemoveCommand}" Margin="6,0,0,0" MinWidth="32" ToolTip="Remove query key" AutomationProperties.Name="Remove query key" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Query parameter key" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="ParameterSpan">
            <Border BorderBrush="{DynamicResource Workspace.Stroke}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveCommand}" Margin="6,0,0,4" ToolTip="Remove this parameter and its values" AutomationProperties.Name="Remove parameter" />
                        <Label Content="Parameter key" Target="{Binding ElementName=ParameterKeyInput}" Foreground="{DynamicResource Workspace.TextPrimary}" Padding="0,4,0,4" />
                    </DockPanel>
                    <TextBox x:Name="ParameterKeyInput" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Parameter key" />
                    <TextBlock Text="Values" Margin="0,10,0,4" />
                    <ItemsControl x:Name="ParameterValues" ItemsSource="{Binding Values}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="×" Command="{Binding RemoveCommand}" Margin="6,0,0,0" MinWidth="32" ToolTip="Remove value" AutomationProperties.Name="Remove parameter value" />
                                <TextBox x:Name="ParameterValueInput" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MaxHeight="100" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Parameter value" />
                            </DockPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="AddParameterValueButton" Content="Add value" Command="{Binding AddValueCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource InlineError}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock Text="{Binding Hint}" Style="{StaticResource Help}" />
        <StackPanel Visibility="{Binding IsProject, Converter={StaticResource VisibleWhen}}">
            <Label Content="Description" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=ProjectDescriptionInput}" />
            <TextBox x:Name="ProjectDescriptionInput" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="140" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Project description" />
        </StackPanel>
        <local:WorkspaceOverrideEditor x:Name="DescriptionOverrideEditor" DataContext="{Binding DescriptionOverride}"
            Visibility="{Binding DataContext.IsRun, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspaceConfigurationEditor}}, Converter={StaticResource VisibleWhen}}" />

        <TextBlock Text="Execution" Style="{StaticResource SectionHeading}" />
        <TextBlock Text="{Binding InheritedLabel}" Style="{StaticResource Inherited}" Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}" />
        <Label Content="Results database" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=ResultsDatabaseInput}" />
        <TextBox x:Name="ResultsDatabaseInput" Text="{Binding ResultsDatabaseName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsRun}" AutomationProperties.Name="Results database" />
        <TextBlock Text="{Binding ResultsDatabaseError}" Style="{StaticResource InlineError}" />
        <Label Content="Execution function" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=ExecuteFunctionInput}" />
        <TextBox x:Name="ExecuteFunctionInput" Text="{Binding ExecuteFunctionName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsRun}" AutomationProperties.Name="Execution function" />
        <TextBlock Text="{Binding ExecuteFunctionError}" Style="{StaticResource InlineError}" />
        <TextBlock Text="Output types" Margin="0,10,0,4" />
        <ItemsControl ItemsSource="{Binding OutputTypes}" ItemTemplate="{StaticResource OutputChoice}" Visibility="{Binding IsProject, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Text="{Binding OutputTypesSummary}" TextWrapping="Wrap" Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Text="Output query keys" Margin="0,10,0,4" />
        <StackPanel Visibility="{Binding IsProject, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Each key must have a matching execution parameter in every run." Style="{StaticResource Help}" />
            <ItemsControl ItemsSource="{Binding OutputQueryKeys}" ItemTemplate="{StaticResource QueryKey}" />
            <Button Content="Add query key" Command="{Binding AddOutputQueryKeyCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding OutputQueryKeysError}" Style="{StaticResource InlineError}" Margin="0,4,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding OutputQueryKeysSummary}" TextWrapping="Wrap" Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}" />
        <StackPanel Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Execution parameters" Style="{StaticResource SectionHeading}" />
            <TextBlock Text="Add a parameter key and its candidate values. Each value has its own field; commas and spaces are kept as entered." Style="{StaticResource Help}" />
            <ItemsControl x:Name="OutputParametersList" ItemsSource="{Binding OutputParameters}" ItemTemplate="{StaticResource ParameterSpan}" />
            <WrapPanel>
                <Button Content="Add parameter" Command="{Binding AddOutputParameterCommand}" Margin="0,0,8,6" />
                <Button x:Name="AddRequiredOutputParametersButton" Content="Add required parameters" Command="{Binding AddMissingOutputParametersCommand}" Margin="0,0,0,6" Visibility="{Binding HasMissingOutputParameters, Converter={StaticResource VisibleWhen}}" />
            </WrapPanel>
            <TextBlock Text="{Binding OutputParametersError}" Style="{StaticResource InlineError}" />
        </StackPanel>

        <StackPanel x:Name="SetupFields" Visibility="{Binding IsBranch, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Setup" Style="{StaticResource SectionHeading}" />
            <StackPanel Visibility="{Binding IsProject, Converter={StaticResource VisibleWhen}}">
                <Label Content="Setup database" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=SetupDatabaseInput}" />
                <TextBox x:Name="SetupDatabaseInput" Text="{Binding SetupDatabaseName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Setup database" />
                <TextBlock Text="{Binding SetupDatabaseError}" Style="{StaticResource InlineError}" />
                <Label Content="Setup function" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=SetupFunctionInput}" />
                <TextBox x:Name="SetupFunctionInput" Text="{Binding SetupFunctionName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Setup function" />
                <TextBlock Text="{Binding SetupFunctionError}" Style="{StaticResource InlineError}" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}">
                <local:WorkspaceOverrideEditor x:Name="SetupDatabaseOverrideEditor" DataContext="{Binding SetupDatabaseOverride}" />
                <local:WorkspaceOverrideEditor x:Name="SetupFunctionOverrideEditor" DataContext="{Binding SetupFunctionOverride}" />
                <TextBlock Text="{Binding InheritedLabel}" Style="{StaticResource Inherited}" />
            </StackPanel>
            <TextBlock Text="Setup output types" Margin="0,10,0,4" />
            <ItemsControl ItemsSource="{Binding SetupOutputTypes}" ItemTemplate="{StaticResource OutputChoice}" Visibility="{Binding IsProject, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding SetupOutputTypesSummary}" TextWrapping="Wrap" Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="Setup query keys" Margin="0,10,0,4" />
            <StackPanel Visibility="{Binding IsProject, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="Used for every setup output type. Each key must have a matching setup parameter in every run." Style="{StaticResource Help}" />
                <ItemsControl ItemsSource="{Binding SetupQueryKeys}" ItemTemplate="{StaticResource QueryKey}" />
                <Button Content="Add query key" Command="{Binding AddSetupQueryKeyCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding SetupQueryKeysError}" Style="{StaticResource InlineError}" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding SetupQueryKeysSummary}" TextWrapping="Wrap" Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}" />
            <StackPanel Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="Setup parameters" Style="{StaticResource SectionHeading}" />
                <ItemsControl x:Name="SetupParametersList" ItemsSource="{Binding SetupParameters}" ItemTemplate="{StaticResource ParameterSpan}" />
                <WrapPanel>
                    <Button Content="Add parameter" Command="{Binding AddSetupParameterCommand}" Margin="0,0,8,6" />
                    <Button x:Name="AddRequiredSetupParametersButton" Content="Add required parameters" Command="{Binding AddMissingSetupParametersCommand}" Margin="0,0,0,6" Visibility="{Binding HasMissingSetupParameters, Converter={StaticResource VisibleWhen}}" />
                </WrapPanel>
                <TextBlock Text="{Binding SetupParametersError}" Style="{StaticResource InlineError}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
