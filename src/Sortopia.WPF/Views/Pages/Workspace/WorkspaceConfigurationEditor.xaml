<UserControl x:Class="Sortopia.WPF.Views.Pages.Workspace.WorkspaceConfigurationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sortopia.WPF.Views.Pages.Workspace"
             xmlns:vm="clr-namespace:Sortopia.WPF.ViewModels.Pages.Workspace"
             Foreground="{DynamicResource Workspace.TextPrimary}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />
        <Style x:Key="EditorSection" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Workspace.TextPrimary}" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HeaderTemplate">
                <Setter.Value><DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"
                                   Style="{StaticResource InlineError}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </DataTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Workspace.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,4,0,6" />
        </Style>
        <DataTemplate x:Key="ListOverrideHeader">
            <StackPanel Margin="0,10,0,4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <CheckBox Content="{Binding OverrideCaption}" IsChecked="{Binding IsOverridden}" MinHeight="28"
                          Visibility="{Binding CanOverride, Converter={StaticResource VisibleWhen}}"
                          Foreground="{DynamicResource Workspace.TextPrimary}" AutomationProperties.Name="{Binding Title, StringFormat=Override {0}}" />
                <local:WorkspaceValueSource x:Name="ValueSource" Margin="0,0,0,4" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="OutputQuery">
            <Border BorderBrush="{DynamicResource Workspace.Stroke}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,6,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TextSummary}" Style="{StaticResource Help}" />
                    <TextBlock Text="{Binding SelectedKeysSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,5">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Workspace.TextPrimary}" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasEmptyProjection}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Workspace.Warning}" />
                            </DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Keys}"><ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,3,0,5">
                            <CheckBox Content="{Binding Key}" IsChecked="{Binding Selected}" IsEnabled="{Binding CanChange}" Foreground="{DynamicResource Workspace.TextPrimary}" AutomationProperties.Name="{Binding Key, StringFormat=Query key {0}}" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Help}" Margin="22,0,0,0" />
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Help}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="RequiredInputs">
            <Border BorderBrush="{DynamicResource Workspace.Stroke}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Required parameter coverage" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Help}" />
                    <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,7,0,5">
                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding HasIssue}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Workspace.Warning}" />
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Help}" Margin="0,2,0,0" />
                            <local:WorkspaceValueSource DataContext="{Binding Source}" />
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ExcludedDefault">
            <DockPanel Margin="0,4,0,4">
                <Button Content="Restore inheritance" Command="{Binding RestoreCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Key, StringFormat=Excluded default: {0}}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="SetupSourceLink">
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,6">
                <Hyperlink Command="{Binding DataContext.SelectValueSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspacePage}}}"
                           CommandParameter="{Binding SourceEditor}" Foreground="{DynamicResource Workspace.Accent}" ToolTip="Select source project">
                    <Run Text="{Binding SourceLabel, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="SetupDataTypeEntry">
            <Border BorderBrush="{DynamicResource Workspace.Stroke}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding DataType.Kind}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DataType.TextSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="Generated from parameters; no source project needed." TextWrapping="Wrap" Margin="0,6,0,6" Visibility="{Binding GeneratesData, Converter={StaticResource VisibleWhen}}" />
                    <StackPanel Visibility="{Binding RequiresSource, Converter={StaticResource VisibleWhen}}">
                    <Label Content="Source project" Target="{Binding ElementName=SetupSourceProjectInput}" Padding="0,0,0,4" Foreground="{DynamicResource Workspace.TextPrimary}" />
                    <ComboBox x:Name="SetupSourceProjectInput" ItemsSource="{Binding SourceProjects}" DisplayMemberPath="Label" SelectedValuePath="Id"
                              SelectedValue="{Binding SourceProjectId, Mode=TwoWay}" ToolTip="{Binding SourceLabel}" AutomationProperties.Name="Setup source project" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SetupSourceLink}" Visibility="{Binding RequiresSource, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="Draft sources must be sealed by saving their first run before this project can save runs." Style="{StaticResource Help}" />
                    <TextBlock Text="{Binding SourceQueryHint}" Style="{StaticResource Help}" />
                    </StackPanel>
                    <TextBlock Text="Query keys" FontWeight="SemiBold" Margin="0,8,0,6" />
                    <TextBlock Text="{Binding QueryKeysSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource InlineError}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="OutputContract">
            <Border BorderBrush="{DynamicResource Workspace.StrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TextSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="Query keys" FontWeight="SemiBold" Margin="0,6,0,4" />
                    <TextBlock Text="{Binding ParameterKeys}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SetupDataTypePreview">
            <Border BorderBrush="{DynamicResource Workspace.StrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding DataType.Kind}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DataType.TextSummary}" TextWrapping="Wrap" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SetupSourceLink}" Visibility="{Binding RequiresSource, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding SourceQueryHint}" Style="{StaticResource Help}" />
                    <TextBlock Text="Query keys" FontWeight="SemiBold" Margin="0,6,0,4" />
                    <TextBlock Text="{Binding QueryKeysSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ParameterSpan">
            <Border BorderBrush="{DynamicResource Workspace.Stroke}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveCommand}" Margin="6,0,0,4" ToolTip="Remove this parameter and its values" AutomationProperties.Name="Remove parameter" />
                        <Label Content="Parameter key" Target="{Binding ElementName=ParameterKeyInput}" Foreground="{DynamicResource Workspace.TextPrimary}" Padding="0,4,0,4" />
                    </DockPanel>
                    <ComboBox x:Name="ParameterKeyInput" ItemsSource="{Binding KeyChoices}" IsEditable="True" IsReadOnly="True" IsTextSearchEnabled="True"
                              Text="{Binding Key, Mode=OneWay}" SelectedItem="{Binding SelectedKey, Mode=TwoWay}" MaxDropDownHeight="260"
                              ToolTip="Choose a required key that has no default. The key determines its value editor and validation." AutomationProperties.Name="Parameter key" />
                    <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Help}" />
                    <TextBlock Text="{Binding DefaultHint}" Style="{StaticResource Help}" />
                    <TextBlock Text="Values" Margin="0,10,0,4" />
                    <TextBlock Text="{Binding ValueHint}" Style="{StaticResource Help}" />
                    <ItemsControl x:Name="ParameterValues" ItemsSource="{Binding Values}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="×" Command="{Binding RemoveCommand}" Margin="6,0,0,0" MinWidth="32" ToolTip="Remove value" AutomationProperties.Name="Remove parameter value" />
                                <local:WorkspaceParameterValueEditor x:Name="ParameterValueEditor" />
                            </DockPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="AddParameterValueButton" Content="Add value" Command="{Binding AddValueCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource InlineError}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ParameterBinding">
            <Border BorderBrush="{DynamicResource Workspace.Stroke}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveCommand}" Margin="6,0,0,4" AutomationProperties.Name="Remove parameter default" />
                        <Label Content="Parameter key" Target="{Binding ElementName=DefaultKeyInput}" Foreground="{DynamicResource Workspace.TextPrimary}" Padding="0,4,0,4" />
                    </DockPanel>
                    <ComboBox x:Name="DefaultKeyInput" IsEditable="True" IsReadOnly="True" IsTextSearchEnabled="True" ItemsSource="{Binding KeyChoices}" MaxDropDownHeight="260"
                              Text="{Binding Key, Mode=OneWay}" SelectedItem="{Binding SelectedKey, Mode=TwoWay}" AutomationProperties.Name="Default parameter key"
                              ToolTip="Choose one of the selected function’s required parameter keys." />
                    <Label Content="Value type" Target="{Binding ElementName=DefaultTypeInput}" Foreground="{DynamicResource Workspace.TextPrimary}" Padding="0,10,0,4" />
                    <ComboBox x:Name="DefaultTypeInput" ItemsSource="{x:Static vm:WorkspaceParameterBinding.ValueTypes}" DisplayMemberPath="Label" SelectedValuePath="Type"
                              SelectedValue="{Binding ValueType, Mode=TwoWay}" IsEnabled="{Binding IsCustomKey}" AutomationProperties.Name="Default parameter type" />
                    <TextBlock Text="{Binding TypeHint}" Style="{StaticResource Help}" />
                    <TextBlock Text="Default value" Margin="0,4,0,4" />
                    <local:WorkspaceParameterValueEditor x:Name="DefaultValueEditor" DataContext="{Binding Value}" />
                    <TextBlock Text="{Binding Value.Hint}" Style="{StaticResource Help}" />
                    <local:WorkspaceValueSource x:Name="LocalParameterValueSource" DataContext="{Binding Source}" />
                    <TextBlock Text="{Binding KeyError}" Style="{StaticResource InlineError}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="InheritedParameterDefault">
            <Border BorderBrush="{DynamicResource Workspace.StrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Help}" />
                    <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Inherited parameter default" />
                    <local:WorkspaceValueSource x:Name="ParameterValueSource" DataContext="{Binding Source}" />
                    <TextBlock Text="{Binding Usage}" Style="{StaticResource Help}" />
                    <Button x:Name="OverrideParameterButton" Content="Override here" Command="{Binding OverrideCommand}" HorizontalAlignment="Left"
                            Visibility="{Binding CanOverride, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding Key, StringFormat=Override {0} here}" />
                    <Button Content="Exclude default here" Command="{Binding ExcludeCommand}" HorizontalAlignment="Left" Visibility="{Binding CanExclude, Converter={StaticResource VisibleWhen}}" Margin="0,4,0,4" />
                </StackPanel>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Expander x:Name="FunctionsSection" Header="{Binding FunctionsTitle}" Style="{StaticResource EditorSection}" IsExpanded="True">
            <StackPanel Margin="4,6,0,0">
                <TextBlock Text="{Binding FunctionsHint}" Style="{StaticResource Help}" />
            <StackPanel x:Name="SetupFunctionItem"><local:WorkspaceOverrideEditor x:Name="SetupFunctionOverrideEditor" DataContext="{Binding SetupFunctionOverride}" />
                <TextBlock Text="{Binding SetupRequirementsHint}" TextWrapping="Wrap" Margin="0,0,0,12" />
            </StackPanel>
        <StackPanel x:Name="ResultsFunctionItem"><local:WorkspaceOverrideEditor x:Name="ResultsFunctionOverrideEditor" DataContext="{Binding ResultsFunctionOverride}" />
            <TextBlock Text="{Binding ResultsRequirementsHint}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="{Binding FunctionCompatibilityError}" Style="{StaticResource InlineError}" />
        </StackPanel>
                <TextBlock Text="{Binding FunctionsStatus}" Style="{StaticResource Help}" />
            </StackPanel>
        </Expander>
        <Expander x:Name="DescriptionSection" Header="Description" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.Description, Mode=TwoWay}">
            <local:WorkspaceOverrideEditor x:Name="DescriptionOverrideEditor" DataContext="{Binding DescriptionOverride}" Margin="4,6,0,0" />
        </Expander>
        <Expander x:Name="ResultsSettingsSection" Header="Results settings" Tag="{Binding ResultsSettingsError}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.ResultsSettings, Mode=TwoWay}">
        <StackPanel Margin="4,6,0,0">
        <StackPanel x:Name="ResultsDatabaseItem"><local:WorkspaceOverrideEditor x:Name="ResultsDatabaseOverrideEditor" Visibility="{Binding DataContext.ShowDatabaseSettings, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspaceConfigurationEditor}}, Converter={StaticResource VisibleWhen}}" DataContext="{Binding ResultsDatabaseOverride}" /></StackPanel>
<StackPanel x:Name="ResultsTypesItem">
        <TextBlock Text="{Binding ResultsContractHint}" Style="{StaticResource Help}" />
        <ContentControl x:Name="OutputTypesHeader" Content="{Binding OutputTypesOverride}" ContentTemplate="{StaticResource ListOverrideHeader}" />
        <StackPanel Visibility="{Binding IsModule, Converter={StaticResource VisibleWhen}}">
            <ItemsControl ItemsSource="{Binding ResultsOutputContracts}" ItemTemplate="{StaticResource OutputContract}" />
            <TextBlock Text="{Binding OutputTypesSummary}" />
        </StackPanel>
        <StackPanel Visibility="{Binding ShowQueryConfiguration, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Results query keys" FontWeight="SemiBold" Margin="0,10,0,4" />
            <TextBlock Text="{Binding QueryConfigurationHint}" Style="{StaticResource Help}" />
            <ItemsControl x:Name="ResultsQueryOutputsList" ItemsSource="{Binding ResultsQueryOutputs}" ItemTemplate="{StaticResource OutputQuery}" />
            <TextBlock Text="{Binding ResultsQueryKeysError}" Style="{StaticResource InlineError}" />
        </StackPanel>
        <TextBlock Text="{Binding OutputTypesError}" Style="{StaticResource InlineError}" />
</StackPanel>

        </StackPanel>
        </Expander>
        <Expander x:Name="ResultsDefaultsSection" Header="Results parameter defaults" Tag="{Binding ResultsParameterDefaultsError}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.ResultsDefaults, Mode=TwoWay}">
        <StackPanel Margin="4,6,0,0">
        <TextBlock Text="{Binding ResultsRequirementsHint}" Style="{StaticResource Help}" />
        <TextBlock Text="{Binding ResultsInputGuidance}" Style="{StaticResource Help}" Visibility="{Binding HasResultsInputGuidance, Converter={StaticResource VisibleWhen}}" />
        <StackPanel Visibility="{Binding IsModule, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,8">
            <Button x:Name="AddRequiredResultsDefaultsButton" Content="Add missing required defaults" Command="{Binding AddRequiredResultsDefaultsCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Add missing required results defaults" />
            <TextBlock Text="{Binding RequiredResultsDefaultsHint}" Style="{StaticResource Help}" />
            <TextBlock Text="{Binding RetainedResultsDefaultsHint}" Style="{StaticResource Help}" />
        </StackPanel>
        <TextBlock Text="Defaults inherit by key. Local values replace matching keys and add new ones; other inherited values remain. Remove a local override to use its parent's value again." Style="{StaticResource Help}" Visibility="{Binding CanEditDefaults, Converter={StaticResource VisibleWhen}}" />
        <CheckBox Content="Show inputs for other model families" IsChecked="{Binding ShowOtherResultsModelInputs}" Visibility="{Binding HasResultsModelInputs, Converter={StaticResource VisibleWhen}}"
                  Foreground="{DynamicResource Workspace.TextPrimary}" Margin="0,4,0,8" ToolTip="Hidden values are retained and remain part of the function's required inputs. Show them to inspect or correct stored values." />
        <StackPanel Visibility="{Binding HasVisibleInheritedOutputDefaults, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding ParameterDefaultsPreviewTitle}" FontWeight="SemiBold" Margin="0,4,0,6" />
            <ItemsControl x:Name="InheritedResultsParameterDefaultsList" ItemsSource="{Binding VisibleInheritedOutputDefaults}" ItemTemplate="{StaticResource InheritedParameterDefault}" />
        </StackPanel>
        <StackPanel Visibility="{Binding CanEditDefaults, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Local defaults" FontWeight="SemiBold" Margin="0,10,0,6" />
            <ItemsControl x:Name="ResultsParameterDefaultsList" ItemsSource="{Binding VisibleResultsParameterDefaults}" ItemTemplate="{StaticResource ParameterBinding}" />
            <Button x:Name="AddResultsParameterDefaultButton" Content="Add default parameter" Command="{Binding AddResultsParameterDefaultCommand}" HorizontalAlignment="Left" />
        </StackPanel>
        <TextBlock Text="{Binding RetainedResultsDefaultsHint}" Style="{StaticResource Help}" />
        <ItemsControl ItemsSource="{Binding ExcludedResultsDefaults}" ItemTemplate="{StaticResource ExcludedDefault}" />
        <TextBlock Text="{Binding ResultsParameterDefaultsSummary}" Style="{StaticResource Help}" />
        <TextBlock Text="{Binding ResultsParameterDefaultsError}" Style="{StaticResource InlineError}" />
        </StackPanel>
        </Expander>
        <StackPanel Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}">
            <Expander x:Name="ResultsSpansSection" Header="Results parameter spans" Tag="{Binding ResultsParametersError}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.ResultsSpans, Mode=TwoWay}">
            <StackPanel Margin="4,6,0,0">
            <ContentControl x:Name="ResultsRequiredInputsSummary" Content="{Binding ResultsRequiredInputs}" ContentTemplate="{StaticResource RequiredInputs}" />
            <TextBlock Text="{Binding ResultsInputGuidance}" Style="{StaticResource Help}" Visibility="{Binding HasResultsInputGuidance, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding ResultsProjectionNotice}" Style="{StaticResource InlineError}" Margin="0,0,0,8" />
            <TextBlock Text="Enter spans only for required parameters that have no default. Then choose each output's query projection below." Style="{StaticResource Help}" />
            <TextBlock Text="{Binding RetainedResultsSpansHint}" Style="{StaticResource Help}" />
            <CheckBox Content="Show inputs for other model families" IsChecked="{Binding ShowOtherResultsModelInputs}" Visibility="{Binding HasResultsModelInputs, Converter={StaticResource VisibleWhen}}"
                      Foreground="{DynamicResource Workspace.TextPrimary}" Margin="0,4,0,8" ToolTip="Hidden spans keep their values and still contribute to the parameter sets. Show them to inspect or correct required inputs." />
            <ItemsControl x:Name="ResultsParametersList" ItemsSource="{Binding VisibleResultsParameters}" ItemTemplate="{StaticResource ParameterSpan}" />
            <WrapPanel>
                <Button Content="Add parameter" Command="{Binding AddResultsParameterCommand}" Margin="0,0,8,6" />
                <Button x:Name="AddRequiredResultsParametersButton" Content="Add missing span rows" Command="{Binding AddMissingResultsParametersCommand}" Margin="0,0,8,6" Visibility="{Binding HasMissingResultsParameters, Converter={StaticResource VisibleWhen}}" />
            </WrapPanel>
            <TextBlock Text="{Binding ResultsParametersError}" Style="{StaticResource InlineError}" />
            <TextBlock Text="{Binding ResultsParameterSetsSummary}" Style="{StaticResource Help}" />
            <Expander Header="Results output query projections" IsExpanded="True" Style="{StaticResource EditorSection}">
                <StackPanel Margin="4,6,0,0">
                    <TextBlock Text="{Binding QueryConfigurationHint}" Style="{StaticResource Help}" />
                    <ItemsControl x:Name="ResultsSpanQueryOutputsList" ItemsSource="{Binding ResultsQueryOutputs}" ItemTemplate="{StaticResource OutputQuery}" />
                </StackPanel>
            </Expander>
            </StackPanel>
            </Expander>
            <Expander x:Name="ResultsPreviewSection" Header="Results parameter sets" Tag="{Binding ResultsParameterSetsPreview.Error}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.ResultsPreview, Mode=TwoWay}">
                <local:WorkspaceParameterSetsPreview x:Name="ResultsSetsPreview" DataContext="{Binding ResultsParameterSetsPreview}" Margin="4,8,0,0" />
            </Expander>
        </StackPanel>

        <StackPanel x:Name="SetupFields" Visibility="{Binding IsBranch, Converter={StaticResource VisibleWhen}}">
            <Expander x:Name="SetupSettingsSection" Header="Setup settings and sources" Tag="{Binding SetupSettingsError}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.SetupSettings, Mode=TwoWay}">
            <StackPanel Margin="4,6,0,0">
            <StackPanel x:Name="SetupDatabaseItem"><local:WorkspaceOverrideEditor x:Name="SetupDatabaseOverrideEditor" Visibility="{Binding DataContext.ShowDatabaseSettings, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspaceConfigurationEditor}}, Converter={StaticResource VisibleWhen}}" DataContext="{Binding SetupDatabaseOverride}" /></StackPanel>
<StackPanel x:Name="SetupOutputsItem">
            <TextBlock Text="{Binding SetupContractHint}" Style="{StaticResource Help}" />
            <ContentControl Content="{Binding SetupDataTypesOverride}" ContentTemplate="{StaticResource ListOverrideHeader}" />
            <StackPanel Visibility="{Binding SetupDataTypesOverride.CanEditValue, Converter={StaticResource VisibleWhen}}">
                <ItemsControl x:Name="SetupDataTypesList" ItemsSource="{Binding SetupDataTypes}" ItemTemplate="{StaticResource SetupDataTypeEntry}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding InheritedSetupDataTypes}" ItemTemplate="{StaticResource SetupDataTypePreview}"
                          Visibility="{Binding SetupDataTypesOverride.ShowPreview, Converter={StaticResource VisibleWhen}}" />
            <StackPanel Visibility="{Binding ShowQueryConfiguration, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="Setup query keys" FontWeight="SemiBold" Margin="0,10,0,4" />
                <TextBlock Text="{Binding QueryConfigurationHint}" Style="{StaticResource Help}" />
                <ItemsControl x:Name="SetupQueryOutputsList" ItemsSource="{Binding SetupQueryOutputs}" ItemTemplate="{StaticResource OutputQuery}" />
                <TextBlock Text="{Binding SetupQueryKeysError}" Style="{StaticResource InlineError}" />
            </StackPanel>
            <TextBlock Text="{Binding SetupDataTypesError}" Style="{StaticResource InlineError}" />
</StackPanel>
            </StackPanel>
            </Expander>
            <Expander x:Name="SetupDefaultsSection" Header="Setup parameter defaults" Tag="{Binding SetupParameterDefaultsError}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.SetupDefaults, Mode=TwoWay}">
            <StackPanel Margin="4,6,0,0">
            <TextBlock Text="{Binding SetupRequirementsHint}" Style="{StaticResource Help}" />
            <TextBlock Text="{Binding SetupInputGuidance}" Style="{StaticResource Help}" Visibility="{Binding HasSetupInputGuidance, Converter={StaticResource VisibleWhen}}" />
            <StackPanel Visibility="{Binding IsModule, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,8">
                <Button x:Name="AddRequiredSetupDefaultsButton" Content="Add missing required defaults" Command="{Binding AddRequiredSetupDefaultsCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Add missing required setup defaults" />
                <TextBlock Text="{Binding RequiredSetupDefaultsHint}" Style="{StaticResource Help}" />
            </StackPanel>
            <TextBlock Text="Setup defaults inherit by key, independently of results defaults. Local overrides replace only the matching key." Style="{StaticResource Help}" Visibility="{Binding CanEditDefaults, Converter={StaticResource VisibleWhen}}" />
            <CheckBox Content="Show inputs for other model families" IsChecked="{Binding ShowOtherSetupModelInputs}" Visibility="{Binding HasSetupModelInputs, Converter={StaticResource VisibleWhen}}"
                      Foreground="{DynamicResource Workspace.TextPrimary}" Margin="0,4,0,8" ToolTip="Hidden values are retained and remain part of the function's required inputs. Show them to inspect or correct stored values." />
            <StackPanel Visibility="{Binding HasVisibleInheritedSetupDefaults, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding ParameterDefaultsPreviewTitle}" FontWeight="SemiBold" Margin="0,4,0,6" />
                <ItemsControl x:Name="InheritedSetupParameterDefaultsList" ItemsSource="{Binding VisibleInheritedSetupDefaults}" ItemTemplate="{StaticResource InheritedParameterDefault}" />
            </StackPanel>
            <StackPanel Visibility="{Binding CanEditDefaults, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="Local defaults" FontWeight="SemiBold" Margin="0,10,0,6" />
                <ItemsControl x:Name="SetupParameterDefaultsList" ItemsSource="{Binding VisibleSetupParameterDefaults}" ItemTemplate="{StaticResource ParameterBinding}" />
                <Button Content="Add default parameter" Command="{Binding AddSetupParameterDefaultCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock Text="{Binding RetainedSetupDefaultsHint}" Style="{StaticResource Help}" />
        <ItemsControl ItemsSource="{Binding ExcludedSetupDefaults}" ItemTemplate="{StaticResource ExcludedDefault}" />
        <TextBlock Text="{Binding SetupParameterDefaultsSummary}" Style="{StaticResource Help}" />
            <TextBlock Text="{Binding SetupParameterDefaultsError}" Style="{StaticResource InlineError}" />
            </StackPanel>
            </Expander>
            <StackPanel Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}">
                <Expander x:Name="SetupSpansSection" Header="Setup parameter spans" Tag="{Binding SetupParametersError}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.SetupSpans, Mode=TwoWay}">
                <StackPanel Margin="4,6,0,0">
                <ContentControl x:Name="SetupRequiredInputsSummary" Content="{Binding SetupRequiredInputs}" ContentTemplate="{StaticResource RequiredInputs}" />
                <TextBlock Text="{Binding SetupInputGuidance}" Style="{StaticResource Help}" Visibility="{Binding HasSetupInputGuidance, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{Binding SetupProjectionNotice}" Style="{StaticResource InlineError}" Margin="0,0,0,8" />
                <TextBlock Text="Enter spans only for required parameters that have no setup default. Then choose each setup output's query projection below." Style="{StaticResource Help}" />
                <TextBlock Text="{Binding RetainedSetupSpansHint}" Style="{StaticResource Help}" />
            <CheckBox Content="Show inputs for other model families" IsChecked="{Binding ShowOtherSetupModelInputs}" Visibility="{Binding HasSetupModelInputs, Converter={StaticResource VisibleWhen}}"
                      Foreground="{DynamicResource Workspace.TextPrimary}" Margin="0,4,0,8" ToolTip="Hidden spans keep their values and still contribute to the parameter sets. Show them to inspect or correct required inputs." />
            <ItemsControl x:Name="SetupParametersList" ItemsSource="{Binding VisibleSetupParameters}" ItemTemplate="{StaticResource ParameterSpan}" />
                <WrapPanel>
                    <Button Content="Add parameter" Command="{Binding AddSetupParameterCommand}" Margin="0,0,8,6" />
                    <Button x:Name="AddRequiredSetupParametersButton" Content="Add missing span rows" Command="{Binding AddMissingSetupParametersCommand}" Margin="0,0,8,6" Visibility="{Binding HasMissingSetupParameters, Converter={StaticResource VisibleWhen}}" />
                </WrapPanel>
                <TextBlock Text="{Binding SetupParametersError}" Style="{StaticResource InlineError}" />
                <TextBlock Text="{Binding SetupParameterSetsSummary}" Style="{StaticResource Help}" />
                <Expander Header="Setup output query projections" IsExpanded="True" Style="{StaticResource EditorSection}">
                    <StackPanel Margin="4,6,0,0">
                        <TextBlock Text="{Binding QueryConfigurationHint}" Style="{StaticResource Help}" />
                        <ItemsControl x:Name="SetupSpanQueryOutputsList" ItemsSource="{Binding SetupQueryOutputs}" ItemTemplate="{StaticResource OutputQuery}" />
                    </StackPanel>
                </Expander>
                </StackPanel>
                </Expander>
                <Expander x:Name="SetupPreviewSection" Header="Setup parameter sets" Tag="{Binding SetupParameterSetsPreview.Error}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.SetupPreview, Mode=TwoWay}">
                    <local:WorkspaceParameterSetsPreview x:Name="SetupSetsPreview" DataContext="{Binding SetupParameterSetsPreview}" Margin="4,8,0,0" />
                </Expander>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
