<UserControl x:Class="Sortopia.WPF.Views.Pages.Workspace.WorkspaceConfigurationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sortopia.WPF.Views.Pages.Workspace"
             xmlns:vm="clr-namespace:Sortopia.WPF.ViewModels.Pages.Workspace"
             Foreground="{DynamicResource Workspace.TextPrimary}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />
        <Geometry x:Key="NoParameterValueIcon">M12,5 A7,7 0 1 0 12,19 A7,7 0 1 0 12,5 Z</Geometry>
        <Geometry x:Key="FixedParameterValueIcon">M8,8 A4,4 0 1 0 8,16 A4,4 0 1 0 8,8 Z M12,12 H22 M18,12 V17 M21,12 V15</Geometry>
        <Geometry x:Key="ParameterSpanIcon">M5,4 H2 V20 H5 M19,4 H22 V20 H19 M7,12 H17 M8,9 V15 M12,9 V15 M16,9 V15</Geometry>
        <DataTemplate x:Key="FunctionParameterValue">
            <Border x:Name="FunctionParameterBorder" BorderBrush="{DynamicResource Workspace.StrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid x:Name="FunctionParameterRow" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Hint}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="FunctionParameterName" Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,12,0"
                               Foreground="{DynamicResource Workspace.TextPrimary}" VerticalAlignment="Center" />
                    <DockPanel Grid.Column="1">
                        <Button x:Name="OpenParameterValueButton" DockPanel.Dock="Right" Width="24" Height="24" Margin="10,0,0,0" VerticalAlignment="Center"
                                Command="{Binding DataContext.OpenFunctionParameterCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspacePage}}}"
                                CommandParameter="{Binding}" Click="OnOpenFunctionParameter" IsEnabled="{Binding CanNavigate}" IsTabStop="{Binding CanNavigate}"
                                ToolTip="{Binding NavigationHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding NavigationLabel}">
                            <Button.Style><Style TargetType="Button">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="IconSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource Workspace.SurfaceHover}" /></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="IconSurface" Property="BorderBrush" Value="{DynamicResource Workspace.Focus}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                                <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger></Style.Triggers>
                            </Style></Button.Style>
                        <Grid x:Name="ParameterSupplyIcon" Width="24" Height="24" ToolTip="{Binding NavigationHint}" AutomationProperties.Name="{Binding IconDescription}">
                            <Path x:Name="ParameterSupplyShape" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Style><Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource NoParameterValueIcon}" />
                                    <Setter Property="Stroke" Value="{DynamicResource Workspace.TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Supply}" Value="{x:Static vm:WorkspaceParameterSupply.Default}">
                                            <Setter Property="Data" Value="{StaticResource FixedParameterValueIcon}" /><Setter Property="Stroke" Value="{DynamicResource Workspace.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Supply}" Value="{x:Static vm:WorkspaceParameterSupply.Span}">
                                            <Setter Property="Data" Value="{StaticResource ParameterSpanIcon}" /><Setter Property="Stroke" Value="{DynamicResource Workspace.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style></Path.Style>
                            </Path>
                        </Grid>
                        </Button>
                        <TextBlock x:Name="FunctionParameterValueText" Text="{Binding Value}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Workspace.TextPrimary}" />
                    </DockPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSourceHeading}" Value="True">
                    <Setter TargetName="FunctionParameterBorder" Property="Margin" Value="0,12,0,0" />
                    <Setter TargetName="FunctionParameterBorder" Property="Padding" Value="0,10,0,8" />
                    <Setter TargetName="FunctionParameterName" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSourceParameter}" Value="True">
                    <Setter TargetName="FunctionParameterName" Property="Margin" Value="18,0,12,0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ReportingSchedule">
            <StackPanel Margin="0,6,0,10">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" HorizontalAlignment="Left" MinWidth="200" />
                <WrapPanel Visibility="{Binding HasInterval, Converter={StaticResource VisibleWhen}}" Margin="0,6,0,0">
                    <TextBlock Text="{Binding IntervalLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" Width="85" AutomationProperties.Name="Generation interval" />
                    <TextBlock Text="generations" VerticalAlignment="Center" Margin="6,0,12,0" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsIncreasing, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="Interval growth fraction" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Growth, UpdateSourceTrigger=PropertyChanged}" Width="85" AutomationProperties.Name="Interval growth fraction" />
                    </StackPanel>
                </WrapPanel>
                <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource VisibleWhen}}" Margin="0,6,0,0">
                    <TextBox Text="{Binding Custom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom generation schedule" />
                    <TextBlock Text="Examples: Cyclic(Constant(5), 3) or Prefixed(10, Constant(1), Constant(100))." TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="EditorSection" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Workspace.TextPrimary}" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HeaderTemplate">
                <Setter.Value><DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"
                                   Style="{StaticResource InlineError}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </DataTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Workspace.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,4,0,6" />
        </Style>
        <DataTemplate x:Key="ListOverrideHeader">
            <StackPanel Margin="0,10,0,4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <CheckBox Content="{Binding OverrideCaption}" IsChecked="{Binding IsOverridden}" MinHeight="28"
                          Visibility="{Binding CanOverride, Converter={StaticResource VisibleWhen}}"
                          Foreground="{DynamicResource Workspace.TextPrimary}" AutomationProperties.Name="{Binding Title, StringFormat=Override {0}}" />
                <local:WorkspaceValueSource x:Name="ValueSource" Margin="0,0,0,4" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="OutputQuery">
            <Border BorderBrush="{DynamicResource Workspace.Stroke}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,6,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TextSummary}" Style="{StaticResource Help}" />
                    <StackPanel Visibility="{Binding HasSetupInputs, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,10">
                        <TextBlock Text="Query keys inherited from setup · Read-only" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding InheritedSetupQueries}"><ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Help}" Margin="0,0,0,2" />
                                <TextBox Text="{Binding KeysSummary, Mode=OneWay}" Style="{StaticResource SelectableMessage}" />
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="Results inherit these keys through the setup files they consume. Supply their spans under setup; no additional results spans are needed for them." Style="{StaticResource Help}" />
                        <TextBlock TextWrapping="Wrap">
                            <Hyperlink x:Name="InheritedSetupQueriesLink" Command="{Binding DataContext.EditProjectQueryProjectionsCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspacePage}}}"
                                       CommandParameter="setupOutputs" Foreground="{DynamicResource Workspace.Accent}">View setup query keys on project</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedKeysSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,5">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Workspace.TextPrimary}" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasNoQueryKeys}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Workspace.Warning}" />
                            </DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Keys}"><ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,3,0,5">
                            <CheckBox Content="{Binding Key}" IsChecked="{Binding Selected}" IsEnabled="{Binding CanChange}" Foreground="{DynamicResource Workspace.TextPrimary}" AutomationProperties.Name="{Binding Key, StringFormat=Query key {0}}" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Help}" Margin="22,0,0,0" />
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Expander Header="Fixed parameters" Foreground="{DynamicResource Workspace.TextPrimary}" IsExpanded="False" Visibility="{Binding HasFixedParameters, Converter={StaticResource VisibleWhen}}">
                        <ItemsControl ItemsSource="{Binding FixedParameters}"><ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,6,0,6">
                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Value}" Style="{StaticResource Help}" />
                                <Button Content="Use as query key" Command="{Binding UseAsQueryKeyCommand}" HorizontalAlignment="Left"
                                        ToolTip="Exclude this fixed default on the project and select the key for this output. Run values start empty."
                                        AutomationProperties.Name="{Binding Key, StringFormat=Use {0} as query key}" />
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </Expander>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Help}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="RequiredInputs">
            <Border BorderBrush="{DynamicResource Workspace.Stroke}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Required parameter coverage" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Help}" />
                    <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,7,0,5">
                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding HasIssue}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Workspace.Warning}" />
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Help}" Margin="0,2,0,0" />
                            <local:WorkspaceValueSource DataContext="{Binding Source}" />
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ExcludedDefault">
            <DockPanel Margin="0,4,0,4">
                <Button Content="Restore fixed default" Command="{Binding RestoreCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"
                        ToolTip="Restore this default and remove the key from this project's output queries. Existing run values are retained for repair." />
                <TextBlock Text="{Binding Key, StringFormat=Excluded default: {0}}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="SetupSourceLink">
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,6">
                <Hyperlink Command="{Binding DataContext.SelectValueSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspacePage}}}"
                           CommandParameter="{Binding SourceEditor}" Foreground="{DynamicResource Workspace.Accent}" ToolTip="Select source project">
                    <Run Text="{Binding SourceLabel, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="SetupDataTypeEntry">
            <Border BorderBrush="{DynamicResource Workspace.Stroke}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding DataType.Kind}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DataType.TextSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="Generated from parameters; no source project needed." TextWrapping="Wrap" Margin="0,6,0,6" Visibility="{Binding GeneratesData, Converter={StaticResource VisibleWhen}}" />
                    <StackPanel Visibility="{Binding RequiresSource, Converter={StaticResource VisibleWhen}}">
                    <CheckBox x:Name="SetupSourceOverrideCheckBox" Content="{Binding SourceOverride.OverrideCaption}"
                              IsChecked="{Binding SourceOverride.IsOverridden}" IsEnabled="{Binding SourceOverride.CanOverride}"
                              Visibility="{Binding SourceOverride.ShowOverrideToggle, Converter={StaticResource VisibleWhen}}"
                              MinHeight="28" Foreground="{DynamicResource Workspace.TextPrimary}"
                              AutomationProperties.Name="{Binding SourceOverride.OverrideAutomationName, StringFormat={}{0} source}" />
                    <local:WorkspaceValueSource DataContext="{Binding SourceOverride}" />
                    <Label Content="Source project" Target="{Binding ElementName=SetupSourceProjectInput}" Padding="0,0,0,4" Foreground="{DynamicResource Workspace.TextPrimary}" />
                    <ComboBox x:Name="SetupSourceProjectInput" ItemsSource="{Binding SourceProjects}" SelectedValuePath="Id" TextSearch.TextPath="Label"
                              IsEnabled="{Binding SourceOverride.CanEditValue}"
                              SelectedValue="{Binding SourceProjectId, Mode=TwoWay}" ToolTip="{Binding SourceLabel}" AutomationProperties.Name="Setup source project"
                              MaxDropDownHeight="420">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MaxWidth="420" Margin="0,3">
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CompatibilityText}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource NetworkComboBoxItemStyle}">
                                <Setter Property="IsEnabled" Value="{Binding IsCompatible}" />
                                <Setter Property="ToolTip" Value="{Binding CompatibilityText}" />
                                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding CompatibilityText}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SetupSourceLink}" Visibility="{Binding RequiresSource, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="You can save unfinished sources and runs as drafts. Complete and save each source's first run before generating this project's run parameters." Style="{StaticResource Help}" />
                    <TextBlock Text="{Binding SourceQueryHint}" Style="{StaticResource Help}" />
                    </StackPanel>
                    <TextBlock Text="Query keys" FontWeight="SemiBold" Margin="0,8,0,6" />
                    <TextBlock Text="{Binding QueryKeysSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource InlineError}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="OutputContract">
            <Border BorderBrush="{DynamicResource Workspace.StrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TextSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="Query keys" FontWeight="SemiBold" Margin="0,6,0,4" />
                    <TextBlock Text="{Binding ParameterKeys}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SetupDataTypePreview">
            <Border BorderBrush="{DynamicResource Workspace.StrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding DataType.Kind}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DataType.TextSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectionOrigin}" Style="{StaticResource Help}" Visibility="{Binding RequiresSource, Converter={StaticResource VisibleWhen}}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SetupSourceLink}" Visibility="{Binding RequiresSource, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding SourceQueryHint}" Style="{StaticResource Help}" />
                    <TextBlock Text="Query keys" FontWeight="SemiBold" Margin="0,6,0,4" />
                    <TextBlock Text="{Binding QueryKeysSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ParameterSpan">
            <Border BorderBrush="{DynamicResource Workspace.Stroke}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="DiscardRetainedParameterButton" DockPanel.Dock="Right" Content="Discard retained values" Command="{Binding RemoveCommand}" Margin="6,0,0,4"
                                Visibility="{Binding IsRepair, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Discard retained parameter" />
                        <TextBlock x:Name="ParameterKeyLabel" Text="{Binding Key}" Foreground="{DynamicResource Workspace.TextPrimary}" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Help}" />
                    <TextBlock Text="{Binding DefaultHint}" Style="{StaticResource Help}" />
                    <TextBlock Text="Values" Foreground="{DynamicResource Workspace.TextPrimary}" Margin="0,10,0,4" />
                    <TextBlock Text="{Binding ValueHint}" Style="{StaticResource Help}" />
                    <ItemsControl x:Name="ParameterValues" ItemsSource="{Binding Values}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="×" Command="{Binding RemoveCommand}" Margin="6,0,0,0" MinWidth="32" ToolTip="Remove value" AutomationProperties.Name="Remove parameter value" />
                                <local:WorkspaceParameterValueEditor x:Name="ParameterValueEditor" />
                            </DockPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="AddParameterValueButton" Content="Add value" Command="{Binding AddValueCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource InlineError}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ParameterBinding">
            <Border BorderBrush="{DynamicResource Workspace.Stroke}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveCommand}" Margin="6,0,0,4" AutomationProperties.Name="Remove parameter default" />
                        <Label Content="Parameter key" Target="{Binding ElementName=DefaultKeyInput}" Foreground="{DynamicResource Workspace.TextPrimary}" Padding="0,4,0,4" />
                    </DockPanel>
                    <ComboBox x:Name="DefaultKeyInput" IsEditable="True" IsReadOnly="True" IsTextSearchEnabled="True" ItemsSource="{Binding KeyChoices}" MaxDropDownHeight="260"
                              Text="{Binding Key, Mode=OneWay}" SelectedItem="{Binding SelectedKey, Mode=TwoWay}" AutomationProperties.Name="Default parameter key"
                              ToolTip="Choose one of the selected function’s required parameter keys." />
                    <Label Content="Value type" Target="{Binding ElementName=DefaultTypeInput}" Foreground="{DynamicResource Workspace.TextPrimary}" Padding="0,10,0,4" />
                    <ComboBox x:Name="DefaultTypeInput" ItemsSource="{x:Static vm:WorkspaceParameterBinding.ValueTypes}" DisplayMemberPath="Label" SelectedValuePath="Type"
                              SelectedValue="{Binding ValueType, Mode=TwoWay}" IsEnabled="{Binding IsCustomKey}" AutomationProperties.Name="Default parameter type" />
                    <TextBlock Text="{Binding TypeHint}" Style="{StaticResource Help}" />
                    <TextBlock Text="Default value" Margin="0,4,0,4" />
                    <local:WorkspaceParameterValueEditor x:Name="DefaultValueEditor" DataContext="{Binding Value}" />
                    <TextBlock Text="{Binding Value.Hint}" Style="{StaticResource Help}" />
                    <local:WorkspaceValueSource x:Name="LocalParameterValueSource" DataContext="{Binding Source}" />
                    <TextBlock Text="{Binding KeyError}" Style="{StaticResource InlineError}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="InheritedParameterDefault">
            <Border BorderBrush="{DynamicResource Workspace.StrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Help}" />
                    <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Inherited parameter default" />
                    <local:WorkspaceValueSource x:Name="ParameterValueSource" DataContext="{Binding Source}" />
                    <TextBlock Text="{Binding Usage}" Style="{StaticResource Help}" />
                    <Button x:Name="OverrideParameterButton" Content="Override here" Command="{Binding OverrideCommand}" HorizontalAlignment="Left"
                            Visibility="{Binding CanOverride, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding Key, StringFormat=Override {0} here}" />
                    <Button Content="Exclude default here" Command="{Binding ExcludeCommand}" HorizontalAlignment="Left" Visibility="{Binding CanExclude, Converter={StaticResource VisibleWhen}}" Margin="0,4,0,4" />
                </StackPanel>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Expander x:Name="FunctionsSection" Style="{StaticResource EditorSection}" IsExpanded="True">
            <StackPanel Margin="4,6,0,0">
                <TextBlock Text="{Binding FunctionsHint}" Style="{StaticResource Help}" />
            <StackPanel x:Name="SetupFunctionItem"><local:WorkspaceOverrideEditor x:Name="SetupFunctionOverrideEditor" DataContext="{Binding SetupFunctionOverride}" />
            <ItemsControl x:Name="SetupFunctionParametersTable" ItemsSource="{Binding SetupFunctionInputs}"
                              ItemTemplate="{StaticResource FunctionParameterValue}" Margin="0,0,0,12" AutomationProperties.Name="Setup function input values" />
                <TextBlock Text="{Binding SetupFunctionParametersHint}" Style="{StaticResource Help}" />
            </StackPanel>
        <StackPanel x:Name="ResultsFunctionItem"><local:WorkspaceOverrideEditor x:Name="ResultsFunctionOverrideEditor" DataContext="{Binding ResultsFunctionOverride}" />
            <ItemsControl x:Name="ResultsFunctionParametersTable" ItemsSource="{Binding ResultsFunctionParameters}"
                          ItemTemplate="{StaticResource FunctionParameterValue}" Margin="0,0,0,12" AutomationProperties.Name="Results function parameter values" />
            <TextBlock Text="{Binding ResultsFunctionParametersHint}" Style="{StaticResource Help}" />
            <TextBlock Text="{Binding FunctionCompatibilityError}" Style="{StaticResource InlineError}" />
        </StackPanel>
                <TextBlock Text="{Binding FunctionsStatus}" Style="{StaticResource Help}" />
            </StackPanel>
        </Expander>
        <Expander x:Name="DescriptionSection" Header="Description" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.Description, Mode=TwoWay}">
            <local:WorkspaceOverrideEditor x:Name="DescriptionOverrideEditor" DataContext="{Binding DescriptionOverride}" Margin="4,6,0,0" />
        </Expander>
        <Expander x:Name="ResultsSettingsSection" Header="Results settings" Tag="{Binding ResultsSettingsError}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.ResultsSettings, Mode=TwoWay}">
        <StackPanel Margin="4,6,0,0">
        <StackPanel x:Name="ResultsDatabaseItem"><local:WorkspaceOverrideEditor x:Name="ResultsDatabaseOverrideEditor" Visibility="{Binding DataContext.ShowDatabaseSettings, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspaceConfigurationEditor}}, Converter={StaticResource VisibleWhen}}" DataContext="{Binding ResultsDatabaseOverride}" /></StackPanel>
<StackPanel x:Name="ResultsTypesItem">
        <TextBlock Text="{Binding ResultsContractHint}" Style="{StaticResource Help}" />
        <ContentControl x:Name="OutputTypesHeader" Content="{Binding OutputTypesOverride}" ContentTemplate="{StaticResource ListOverrideHeader}" />
        <StackPanel Visibility="{Binding IsModule, Converter={StaticResource VisibleWhen}}">
            <ItemsControl ItemsSource="{Binding ResultsOutputContracts}" ItemTemplate="{StaticResource OutputContract}" />
            <TextBlock Text="{Binding OutputTypesSummary}" />
        </StackPanel>
        <StackPanel Visibility="{Binding ShowQueryConfiguration, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Results query keys" FontWeight="SemiBold" Margin="0,10,0,4" />
            <TextBlock Text="{Binding QueryConfigurationHint}" Style="{StaticResource Help}" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}">
                <Hyperlink x:Name="ResultsProjectQueriesLink" Command="{Binding DataContext.EditProjectQueryProjectionsCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspacePage}}}"
                           CommandParameter="resultsTypes" Foreground="{DynamicResource Workspace.Accent}">Edit results projections on project</Hyperlink>
            </TextBlock>
            <ItemsControl x:Name="ResultsQueryOutputsList" ItemsSource="{Binding ResultsQueryOutputs}" ItemTemplate="{StaticResource OutputQuery}" />
            <TextBlock Text="{Binding ResultsQueryKeysError}" Style="{StaticResource InlineError}" />
        </StackPanel>
        <TextBlock Text="{Binding OutputTypesError}" Style="{StaticResource InlineError}" />
</StackPanel>

        </StackPanel>
        </Expander>
        <Expander x:Name="ResultsDefaultsSection" Header="Results parameter defaults" Tag="{Binding ResultsParameterDefaultsError}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.ResultsDefaults, Mode=TwoWay}">
        <StackPanel Margin="4,6,0,0">
        <TextBlock Text="{Binding ResultsRequirementsHint}" Style="{StaticResource Help}" />
        <TextBlock Text="{Binding ResultsInputGuidance}" Style="{StaticResource Help}" Visibility="{Binding HasResultsInputGuidance, Converter={StaticResource VisibleWhen}}" />
        <StackPanel Visibility="{Binding IsModule, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,8">
            <Button x:Name="AddRequiredResultsDefaultsButton" Content="Add missing required defaults" Command="{Binding AddRequiredResultsDefaultsCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Add missing required results defaults" />
            <TextBlock Text="{Binding RequiredResultsDefaultsHint}" Style="{StaticResource Help}" />
            <TextBlock Text="{Binding RetainedResultsDefaultsHint}" Style="{StaticResource Help}" />
        </StackPanel>
        <TextBlock Text="Defaults inherit by key. Local values replace matching keys and add new ones; other inherited values remain. Remove a local override to use its parent's value again." Style="{StaticResource Help}" Visibility="{Binding CanEditDefaults, Converter={StaticResource VisibleWhen}}" />
        <StackPanel Visibility="{Binding HasInheritedOutputDefaults, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding ParameterDefaultsPreviewTitle}" FontWeight="SemiBold" Margin="0,4,0,6" />
            <ItemsControl x:Name="InheritedResultsParameterDefaultsList" ItemsSource="{Binding InheritedOutputDefaults}" ItemTemplate="{StaticResource InheritedParameterDefault}" />
        </StackPanel>
        <StackPanel Visibility="{Binding CanEditDefaults, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Local defaults" FontWeight="SemiBold" Margin="0,10,0,6" />
            <ItemsControl x:Name="ResultsParameterDefaultsList" ItemsSource="{Binding EditableResultsParameterDefaults}" ItemTemplate="{StaticResource ParameterBinding}" />
            <Button x:Name="AddResultsParameterDefaultButton" Content="Add default parameter" Command="{Binding AddResultsParameterDefaultCommand}" HorizontalAlignment="Left" />
        </StackPanel>
        <TextBlock Text="{Binding RetainedResultsDefaultsHint}" Style="{StaticResource Help}" />
        <ItemsControl ItemsSource="{Binding ExcludedResultsDefaults}" ItemTemplate="{StaticResource ExcludedDefault}" />
        <TextBlock Text="{Binding ResultsParameterDefaultsSummary}" Style="{StaticResource Help}" />
        <TextBlock Text="{Binding ResultsParameterDefaultsError}" Style="{StaticResource InlineError}" />
        </StackPanel>
        </Expander>
        <Expander x:Name="EvolutionReportingSection" Header="Evolution reporting" IsExpanded="True" Style="{StaticResource EditorSection}"
                  Visibility="Collapsed" Tag="{Binding ReportingError}">
                <StackPanel Margin="4,6,0,0">
                    <StackPanel Visibility="{Binding UsesSnapshotControls, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="SnapshotInterval" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SnapshotInterval, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSnapshotInterval}" AutomationProperties.Name="SnapshotInterval" />
                        <TextBlock Text="Generations between full snapshots. Locked after runParameters are created." Style="{StaticResource Help}" />
                        <TextBlock Text="SnapshotCount" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SnapshotCount, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSnapshotCount}" AutomationProperties.Name="SnapshotCount" />
                        <TextBlock Text="Number of snapshots after generation zero. Increase and save to extend the run; execute its parameter files to continue from the latest checkpoint." Style="{StaticResource Help}" />
                        <TextBlock Text="{Binding SnapshotTargetText}" Style="{StaticResource Help}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowLegacyReporting, Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsEditable}">
                        <CheckBox Content="Save evolution snapshots and summaries" IsChecked="{Binding ReportingEnabled}" Foreground="{DynamicResource Workspace.TextPrimary}" />
                        <TextBlock Text="Legacy run: GenerationCount must fall on both reporting schedules." Style="{StaticResource Help}" />
                        <ContentControl Content="{Binding SnapshotReporting}" ContentTemplate="{StaticResource ReportingSchedule}" />
                    </StackPanel>
                    <StackPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding ReportingEnabled, Converter={StaticResource VisibleWhen}}">
                        <ContentControl Content="{Binding SummaryReporting}" ContentTemplate="{StaticResource ReportingSchedule}" />
                    </StackPanel>
                    <TextBlock x:Name="EvolutionReportingError" Text="{Binding ReportingError}" Style="{StaticResource InlineError}" />
                    <TextBlock Text="Full snapshots retain every model, mutation cursor and evaluation. Summaries retain pool statistics. Export CSV reports from Results execution after the run completes." Style="{StaticResource Help}" />
                </StackPanel>
        </Expander>
        <StackPanel Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}">
            <Expander x:Name="ResultsSpansSection" Header="Results parameter spans" Tag="{Binding ResultsParametersError}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.ResultsSpans, Mode=TwoWay}">
            <StackPanel Margin="4,6,0,0">
            <ContentControl x:Name="ResultsRequiredInputsSummary" Content="{Binding ResultsRequiredInputs}" ContentTemplate="{StaticResource RequiredInputs}" />
            <TextBlock Text="{Binding ResultsInputGuidance}" Style="{StaticResource Help}" Visibility="{Binding HasResultsInputGuidance, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding ResultsProjectionNotice}" Style="{StaticResource InlineError}" Margin="0,0,0,8" />
            <TextBlock Text="Enter spans only for required parameters that have no default. Output query projections are inherited from the project." Style="{StaticResource Help}" />
            <TextBlock Text="{Binding RetainedResultsSpansHint}" Style="{StaticResource Help}" />
            <ItemsControl x:Name="ResultsParametersList" ItemsSource="{Binding DeclaredResultsParameters}" ItemTemplate="{StaticResource ParameterSpan}" />
            <Expander Header="Retained inputs needing repair" Foreground="{DynamicResource Workspace.TextPrimary}" IsExpanded="True" Visibility="{Binding HasResultsParameterRepairs, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <TextBlock Text="These inputs no longer match the project, or duplicate another span. Re-select the key on the project to reuse its values, or discard the retained row." Style="{StaticResource Help}" />
                    <ItemsControl x:Name="ResultsRepairParametersList" ItemsSource="{Binding RepairResultsParameters}" ItemTemplate="{StaticResource ParameterSpan}" />
                </StackPanel>
            </Expander>
            <TextBlock Text="{Binding ResultsParametersError}" Style="{StaticResource InlineError}" />
            <TextBlock Text="{Binding ResultsParameterSetsSummary}" Style="{StaticResource Help}" />
            <Expander Header="Results output query projections" IsExpanded="True" Style="{StaticResource EditorSection}">
                <StackPanel Margin="4,6,0,0">
                    <TextBlock Text="{Binding QueryConfigurationHint}" Style="{StaticResource Help}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                        <Hyperlink x:Name="ResultsSpanProjectQueriesLink" Command="{Binding DataContext.EditProjectQueryProjectionsCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspacePage}}}"
                                   CommandParameter="resultsTypes" Foreground="{DynamicResource Workspace.Accent}">Edit results projections on project</Hyperlink>
                    </TextBlock>
                    <ItemsControl x:Name="ResultsSpanQueryOutputsList" ItemsSource="{Binding ResultsQueryOutputs}" ItemTemplate="{StaticResource OutputQuery}" />
                </StackPanel>
            </Expander>
            </StackPanel>
            </Expander>
        </StackPanel>

        <StackPanel x:Name="SetupFields" Visibility="{Binding IsBranch, Converter={StaticResource VisibleWhen}}">
            <Expander x:Name="SetupSettingsSection" Header="Setup settings and sources" Tag="{Binding SetupSettingsError}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.SetupSettings, Mode=TwoWay}">
            <StackPanel Margin="4,6,0,0">
            <StackPanel x:Name="SetupDatabaseItem"><local:WorkspaceOverrideEditor x:Name="SetupDatabaseOverrideEditor" Visibility="{Binding DataContext.ShowDatabaseSettings, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspaceConfigurationEditor}}, Converter={StaticResource VisibleWhen}}" DataContext="{Binding SetupDatabaseOverride}" /></StackPanel>
<StackPanel x:Name="SetupOutputsItem">
            <TextBlock Text="{Binding SetupContractHint}" Style="{StaticResource Help}" />
            <TextBlock Text="Each source inherits independently. Check Define to select a source here, or Override to replace an inherited source. Clear its checkbox to inherit again." Style="{StaticResource Help}" Visibility="{Binding CanEditDefaults, Converter={StaticResource VisibleWhen}}" />
            <StackPanel Visibility="{Binding CanEditDefaults, Converter={StaticResource VisibleWhen}}">
                <ItemsControl x:Name="SetupDataTypesList" ItemsSource="{Binding SetupDataTypes}" ItemTemplate="{StaticResource SetupDataTypeEntry}" />
            </StackPanel>
            <ItemsControl x:Name="InheritedSetupDataTypesList" ItemsSource="{Binding InheritedSetupDataTypes}" ItemTemplate="{StaticResource SetupDataTypePreview}"
                          Visibility="{Binding ShowSetupSourcePreview, Converter={StaticResource VisibleWhen}}" />
            <StackPanel Visibility="{Binding ShowQueryConfiguration, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="Setup query keys" FontWeight="SemiBold" Margin="0,10,0,4" />
                <TextBlock Text="{Binding QueryConfigurationHint}" Style="{StaticResource Help}" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}">
                    <Hyperlink x:Name="SetupProjectQueriesLink" Command="{Binding DataContext.EditProjectQueryProjectionsCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspacePage}}}"
                               CommandParameter="setupOutputs" Foreground="{DynamicResource Workspace.Accent}">Edit setup projections on project</Hyperlink>
                </TextBlock>
                <ItemsControl x:Name="SetupQueryOutputsList" ItemsSource="{Binding SetupQueryOutputs}" ItemTemplate="{StaticResource OutputQuery}" />
                <TextBlock Text="{Binding SetupQueryKeysError}" Style="{StaticResource InlineError}" />
            </StackPanel>
            <TextBlock Text="{Binding SetupDataTypesError}" Style="{StaticResource InlineError}" />
</StackPanel>
            </StackPanel>
            </Expander>
            <Expander x:Name="SetupDefaultsSection" Header="Setup parameter defaults" Tag="{Binding SetupParameterDefaultsError}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.SetupDefaults, Mode=TwoWay}">
            <StackPanel Margin="4,6,0,0">
            <TextBlock Text="{Binding SetupRequirementsHint}" Style="{StaticResource Help}" />
            <TextBlock Text="{Binding SetupInputGuidance}" Style="{StaticResource Help}" Visibility="{Binding HasSetupInputGuidance, Converter={StaticResource VisibleWhen}}" />
            <StackPanel Visibility="{Binding IsModule, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,8">
                <Button x:Name="AddRequiredSetupDefaultsButton" Content="Add missing required defaults" Command="{Binding AddRequiredSetupDefaultsCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Add missing required setup defaults" />
                <TextBlock Text="{Binding RequiredSetupDefaultsHint}" Style="{StaticResource Help}" />
            </StackPanel>
            <TextBlock Text="Setup defaults inherit by key, independently of results defaults. Local overrides replace only the matching key." Style="{StaticResource Help}" Visibility="{Binding CanEditDefaults, Converter={StaticResource VisibleWhen}}" />
            <StackPanel Visibility="{Binding HasInheritedSetupDefaults, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding ParameterDefaultsPreviewTitle}" FontWeight="SemiBold" Margin="0,4,0,6" />
                <ItemsControl x:Name="InheritedSetupParameterDefaultsList" ItemsSource="{Binding InheritedSetupDefaults}" ItemTemplate="{StaticResource InheritedParameterDefault}" />
            </StackPanel>
            <StackPanel Visibility="{Binding CanEditDefaults, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="Local defaults" FontWeight="SemiBold" Margin="0,10,0,6" />
                <ItemsControl x:Name="SetupParameterDefaultsList" ItemsSource="{Binding EditableSetupParameterDefaults}" ItemTemplate="{StaticResource ParameterBinding}" />
                <Button Content="Add default parameter" Command="{Binding AddSetupParameterDefaultCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock Text="{Binding RetainedSetupDefaultsHint}" Style="{StaticResource Help}" />
        <ItemsControl ItemsSource="{Binding ExcludedSetupDefaults}" ItemTemplate="{StaticResource ExcludedDefault}" />
        <TextBlock Text="{Binding SetupParameterDefaultsSummary}" Style="{StaticResource Help}" />
            <TextBlock Text="{Binding SetupParameterDefaultsError}" Style="{StaticResource InlineError}" />
            </StackPanel>
            </Expander>
            <StackPanel Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}">
                <Expander x:Name="SetupSpansSection" Header="Setup parameter spans" Tag="{Binding SetupParametersError}" Style="{StaticResource EditorSection}" IsExpanded="{Binding Sections.SetupSpans, Mode=TwoWay}">
                <StackPanel Margin="4,6,0,0">
                <ContentControl x:Name="SetupRequiredInputsSummary" Content="{Binding SetupRequiredInputs}" ContentTemplate="{StaticResource RequiredInputs}" />
                <TextBlock Text="{Binding SetupInputGuidance}" Style="{StaticResource Help}" Visibility="{Binding HasSetupInputGuidance, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{Binding SetupProjectionNotice}" Style="{StaticResource InlineError}" Margin="0,0,0,8" />
                <TextBlock Text="Enter values for each setup query key. The project defines these rows." Style="{StaticResource Help}" />
                <TextBlock Text="{Binding RetainedSetupSpansHint}" Style="{StaticResource Help}" />
            <ItemsControl x:Name="SetupParametersList" ItemsSource="{Binding DeclaredSetupParameters}" ItemTemplate="{StaticResource ParameterSpan}" />
                <Expander Header="Retained inputs needing repair" Foreground="{DynamicResource Workspace.TextPrimary}" IsExpanded="True" Visibility="{Binding HasSetupParameterRepairs, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Text="These inputs no longer match the project, or duplicate another span. Re-select the key on the project to reuse its values, or discard the retained row." Style="{StaticResource Help}" />
                        <ItemsControl x:Name="SetupRepairParametersList" ItemsSource="{Binding RepairSetupParameters}" ItemTemplate="{StaticResource ParameterSpan}" />
                    </StackPanel>
                </Expander>
                <TextBlock Text="{Binding SetupParametersError}" Style="{StaticResource InlineError}" />
                <TextBlock Text="{Binding SetupParameterSetsSummary}" Style="{StaticResource Help}" />
                <Expander Header="Setup output query projections" IsExpanded="True" Style="{StaticResource EditorSection}">
                    <StackPanel Margin="4,6,0,0">
                        <TextBlock Text="{Binding QueryConfigurationHint}" Style="{StaticResource Help}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                            <Hyperlink x:Name="SetupSpanProjectQueriesLink" Command="{Binding DataContext.EditProjectQueryProjectionsCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkspacePage}}}"
                                       CommandParameter="setupOutputs" Foreground="{DynamicResource Workspace.Accent}">Edit setup projections on project</Hyperlink>
                        </TextBlock>
                        <ItemsControl x:Name="SetupSpanQueryOutputsList" ItemsSource="{Binding SetupQueryOutputs}" ItemTemplate="{StaticResource OutputQuery}" />
                    </StackPanel>
                </Expander>
                </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
