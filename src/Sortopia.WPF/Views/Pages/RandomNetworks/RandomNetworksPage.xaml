<UserControl x:Class="Sortopia.WPF.Views.Pages.RandomNetworks.RandomNetworksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sortopia.WPF.Views.Shared.Controls"
             AutomationProperties.Name="Random Networks page"
             Foreground="{DynamicResource Workspace.TextPrimary}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Sortopia.WPF;component/Styles/NetworkWorkspace.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource Workspace.TextSecondary}" /><Setter Property="Padding" Value="0,0,8,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource NetworkComboBoxStyle}" />
            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}"><Setter Property="Padding" Value="12,5" /><Setter Property="MinHeight" Value="32" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
            <Style x:Key="ValidationMessage" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Workspace.Warning}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,4" />
                <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border MinHeight="{Binding ViewportHeight, ElementName=PageScroll}">
    <Grid x:Name="PageRows" Background="{StaticResource Workspace.Canvas}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="←" Command="{Binding ReturnHomeCommand}" Margin="8,0,0,8" VerticalAlignment="Top"
                        ToolTip="Back to Sortopia" AutomationProperties.Name="Back to Sortopia" />
                <WrapPanel IsEnabled="{Binding CanEdit}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <Label Content="_Method" Target="{Binding ElementName=MethodPicker}" />
                        <ComboBox x:Name="MethodPicker" Width="100" ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" AutomationProperties.Name="Generation method" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <Label Content="_Channels" Target="{Binding ElementName=ChannelPicker}" />
                        <ComboBox x:Name="ChannelPicker" Width="70" ItemsSource="{Binding ChannelCounts}" SelectedItem="{Binding ChannelCount}" ToolTip="{Binding WidthHint}" AutomationProperties.Name="Channel count" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <Label Content="_CE count" Target="{Binding ElementName=CeCountInput}" />
                        <TextBox x:Name="CeCountInput" Width="90" Text="{Binding CeCountText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SizeHint}" AutomationProperties.Name="CE count" />
                    </StackPanel>
                    <Button Content="Generate" Command="{Binding GenerateCommand}" Margin="0,0,0,8" Style="{StaticResource PrimaryAction}"
                            ToolTip="Generate a fresh random network with these settings." AutomationProperties.Name="Generate network" />
                </WrapPanel>
            </DockPanel>
            <TextBlock Text="{Binding InputError}" Style="{StaticResource ValidationMessage}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,2,0,8">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" IsEnabled="{Binding CanEdit}">
                    <Label Content="Test _inputs" Target="{Binding ElementName=TestInputs}" />
                    <TextBox x:Name="TestInputs" Width="100" Text="{Binding SamplesText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding TestHint}" AutomationProperties.Name="Test inputs" />
                </StackPanel>
                <Button Content="Test" Command="{Binding TestCommand}" AutomationProperties.Name="Test generated network" Margin="0,0,8,4" />
                <Button Content="Cancel" Command="{Binding CancelTestCommand}" Style="{StaticResource StopAction}" AutomationProperties.Name="Cancel current test" Margin="0,0,16,4" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Workspace.TextSecondary}" AutomationProperties.LiveSetting="Polite" />
            </WrapPanel>
            <TextBlock Text="{Binding TestInputError}" Style="{StaticResource ValidationMessage}" />
        </StackPanel>
        <WrapPanel Grid.Row="2" Margin="0,0,0,4">
            <controls:StageLayoutSelector x:Name="StageLayouts" Mode="{Binding DisplayMode}" HasTestResults="{Binding CanChooseTestedLayouts}"
                                       IsEnabled="{Binding CanEdit}" Margin="0,0,14,0" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                <Label Content="_Zoom" Target="{Binding ElementName=ZoomSlider}" />
                <Slider x:Name="ZoomSlider" Width="120" Minimum="1" Maximum="8" Value="{Binding ZoomFactor}" SmallChange="0.25" LargeChange="1"
                        VerticalAlignment="Center" AutomationProperties.Name="Diagram zoom" ToolTip="Fit at the left end. Zoom in, then drag the diagram to pan. Ctrl+wheel also zooms." />
                <TextBlock Text="{Binding ZoomLabel}" Width="36" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource Workspace.TextPrimary}" />
            </StackPanel>
        </WrapPanel>
        <TextBlock Grid.Row="3" Text="{Binding ResultsSummary}" TextWrapping="Wrap" Foreground="{StaticResource Workspace.TextPrimary}" Margin="0,0,0,8"
                   AutomationProperties.Name="{Binding ResultsSummary}" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="CE swap frequency" FontSize="12" Foreground="{StaticResource Workspace.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,4" />
            <ItemsControl ItemsSource="{Binding UsageBands}" AutomationProperties.Name="CE swap percentage legend" ToolTip="Percentage of tested inputs that caused each CE to swap. Hover over a CE for its exact count.">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="{Binding Fill}" Padding="4,3" MinWidth="30" ToolTip="{Binding Description}" Margin="0,0,0,4">
                        <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </WrapPanel>
        <Border Grid.Row="5" BorderBrush="{StaticResource Workspace.StrokeSubtle}" BorderThickness="1" CornerRadius="8">
            <Canvas x:Name="DiagramHost">
            <ScrollViewer x:Name="DiagramViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="12"
                          Width="{Binding ActualWidth, ElementName=DiagramHost}" Height="{Binding ActualHeight, ElementName=DiagramHost}"
                          AutomationProperties.Name="Network diagram viewport" Background="Transparent"
                          PreviewMouseLeftButtonDown="StartPan" PreviewMouseMove="MovePan" PreviewMouseLeftButtonUp="EndPan"
                          LostMouseCapture="LostPanCapture" PreviewMouseWheel="ZoomWithWheel">
                <controls:NetworkDiagram x:Name="Diagram" StaticNetwork="{Binding SelectedNetwork}" Usage="{Binding Usage}" DisplayMode="{Binding DisplayMode}"
                                         DisplayTransitionMilliseconds="1100"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ScrollViewer>
            </Canvas>
        </Border>
    </Grid>
    </Border>
    </ScrollViewer>
</UserControl>
