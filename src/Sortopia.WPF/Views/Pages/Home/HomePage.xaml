<UserControl x:Class="Sortopia.WPF.Views.Pages.Home.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Sortopia home" Foreground="{DynamicResource Workspace.TextPrimary}">
    <Grid Background="{StaticResource Workspace.Canvas}">
        <Grid Margin="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Workspace.Surface}" BorderBrush="{StaticResource Workspace.StrokeSubtle}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Text="Sortopia" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="Sorting network tools" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,0,0,20" />
                    <Button Content="_Sorting networks" Command="{Binding OpenNetworksCommand}"
                            AutomationProperties.Name="Sorting networks" ToolTip="Explore the sorting network catalog" />
                    <Button Content="_Random networks" Command="{Binding OpenRandomNetworksCommand}"
                            AutomationProperties.Name="Random networks" ToolTip="Generate and test random sorting networks" />
                    <Button Content="S_GD" Command="{Binding OpenSgdCommand}"
                            AutomationProperties.Name="SGD" ToolTip="Improve a network through mutation and selection" />
                    <Button Content="_Workspace" Command="{Binding OpenWorkspaceCommand}" Margin="0"
                            AutomationProperties.Name="Workspace" ToolTip="Choose your Workspace folder" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource Workspace.Surface}" BorderBrush="{StaticResource Workspace.StrokeSubtle}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Image Source="/Sortopia.WPF;component/Assets/sortopia-fisherman.png" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Sortopia fisherman with sorting networks" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
