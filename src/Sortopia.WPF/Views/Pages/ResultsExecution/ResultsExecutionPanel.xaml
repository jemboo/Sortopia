<UserControl x:Class="Sortopia.WPF.Views.Pages.ResultsExecution.ResultsExecutionPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shared="clr-namespace:Sortopia.WPF.Views.Shared"
 Foreground="{DynamicResource Workspace.TextPrimary}">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" /></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="ErrorVisibility" />
  <DataTemplate x:Key="ExecutionExpander">
   <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                 ToolTip="Show or hide row details" AutomationProperties.Name="{Binding FileName, StringFormat=Show or hide details for {0}}">
    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
      <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="{StaticResource Workspace.TextPrimary}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M 0,0 L 4,4 L 8,0" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Workspace.SurfaceHover}" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Workspace.Focus}" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></ToggleButton.Template>
   </ToggleButton>
  </DataTemplate>
  <DataTemplate x:Key="ExecutionCheck">
   <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding FileName, StringFormat=Execute {0}}" />
  </DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Run parameter files" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
   <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
    <TextBox Text="{Binding Folder, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Run parameters folder" /></DockPanel>
   <TextBlock Text="Run filter" Margin="0,10,0,4" Foreground="{StaticResource Workspace.TextSecondary}" />
   <ComboBox x:Name="RunFilterInput" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseRun}" AutomationProperties.Name="Filter parameter files by run" />
   <WrapPanel Margin="0,10,0,0">
    <StackPanel Margin="0,0,16,0">
     <TextBlock Text="CPU limit (%)" />
     <TextBox x:Name="CpuLimitInput" Text="{Binding CpuPercent, UpdateSourceTrigger=PropertyChanged}" Width="95" AutomationProperties.Name="CPU limit percent" />
    </StackPanel>
    <StackPanel Margin="0,0,16,0">
     <TextBlock Text="Memory budget" />
     <TextBox x:Name="MemoryLimitInput" Text="{Binding MemoryLimit, UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.Name="Batch memory budget" />
    </StackPanel>
    <StackPanel>
     <TextBlock Text="Parallel files" />
     <TextBox x:Name="ParallelFilesInput" Text="{Binding ParallelFiles, UpdateSourceTrigger=PropertyChanged}" Width="100" AutomationProperties.Name="Maximum parallel files" />
    </StackPanel>
   </WrapPanel>
   <TextBlock Text="{Binding LaunchLimitsError}" Style="{StaticResource InlineError}" TextWrapping="Wrap" />
  </StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,10,0,4">
   <Button x:Name="ExecuteSelectedButton" Content="Execute in terminal" Command="{Binding ExecuteCommandLineCommand}" Margin="0,0,8,6" />
   <Button x:Name="OpenRunButton" Content="Open run in workspace" Command="{Binding OpenRunCommand}" Margin="0,0,8,6" />
   <Button x:Name="UpdateProgressButton" Content="Update progress" Command="{Binding UpdateProgressCommand}" Margin="0,0,8,6" />
   <Button x:Name="OpenEvolutionHistoryButton" Content="View evolution histograms" Command="{Binding OpenEvolutionHistoryCommand}" Margin="0,0,8,6" />
   <Button x:Name="ExportReportsButton" Content="Export CSV reports" Command="{Binding ExportReportsCommand}" Margin="0,0,8,6" />
   <Button Content="Check all" Command="{Binding SelectAllCommand}" Margin="0,0,8,6" />
   <Button Content="Check pending" Command="{Binding SelectPendingCommand}" Margin="0,0,8,6" />
   <Button Content="Uncheck all" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,6" />
   <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
   <Button x:Name="ValidateFullyButton" Content="Fully validate" Command="{Binding ValidateFullyCommand}" Margin="0,0,8,6" />
   <Button Content="Cancel inspection" Command="{Binding CancelCommand}" Margin="0,0,8,6" />
  </WrapPanel>
  <StackPanel Grid.Row="2" Margin="0,0,0,8">
   <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
   <StackPanel Visibility="{Binding HasSnapshotProgress, Converter={StaticResource ErrorVisibility}}" Margin="0,6,0,2">
    <TextBlock x:Name="BatchProgressSummary" Text="{Binding SnapshotProgressSummary}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <ProgressBar x:Name="BatchProgressBar" Minimum="0" Maximum="100" Value="{Binding SnapshotProgressPercent, Mode=OneWay}" Height="6" Margin="0,5,0,0"
                 AutomationProperties.Name="Saved snapshot progress" />
   </StackPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0" />
   <TextBlock Text="{Binding Error}" Style="{StaticResource InlineError}" TextWrapping="Wrap" />
  </StackPanel>
  <DataGrid x:Name="RunParametersGrid" Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" IsReadOnly="True"
            shared:SetupQueryColumns.InsertIndex="5" shared:SetupQueryColumns.Rows="{Binding Rows}" CanUserSortColumns="True"
            CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
            HeadersVisibility="All" FrozenColumnCount="5" MinHeight="140"
            AreRowDetailsFrozen="True"
            EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
            AutomationProperties.Name="Run parameter files and output status">
   <DataGrid.RowStyle><Style TargetType="DataGridRow">
    <Setter Property="ToolTip" Value="{Binding Error}" />
    <Setter Property="DetailsVisibility" Value="{Binding IsExpanded, Converter={StaticResource ErrorVisibility}}" />
   </Style></DataGrid.RowStyle>
   <DataGrid.RowDetailsTemplate><DataTemplate>
    <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}" Padding="8,2,36,6" HorizontalAlignment="Left">
     <StackPanel>
     <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Run parameter file details" Margin="0,4,0,8" />
     <Expander Header="Inherited setup query values" IsExpanded="True" Foreground="{StaticResource Workspace.TextPrimary}" AutomationProperties.Name="Inherited setup query value details"
               Visibility="{Binding HasSetupInputs, Converter={StaticResource ErrorVisibility}}">
      <TextBox Text="{Binding InheritedSetupQueryDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Inherited setup query values" Margin="0,6,0,0" />
     </Expander>
     <Expander Header="Error details" IsExpanded="True" Foreground="{StaticResource Workspace.TextPrimary}" AutomationProperties.Name="Run parameter error details"
               Visibility="{Binding HasError, Converter={StaticResource ErrorVisibility}}">
      <TextBox Text="{Binding Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Run parameter error" Margin="0,6,0,0" />
     </Expander>
     </StackPanel>
    </Border>
   </DataTemplate></DataGrid.RowDetailsTemplate>
  </DataGrid>
  <StackPanel Grid.Row="4">
   <Expander Header="Command line for checked files" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,10,0,0"><StackPanel>
    <DockPanel>
     <Button x:Name="ExecuteCommandLineButton" DockPanel.Dock="Right" Content="Execute" Command="{Binding ExecuteCommandLineCommand}" Margin="8,0,0,0" VerticalAlignment="Top"
             AutomationProperties.Name="Execute command for checked files in a terminal" />
     <TextBox Text="{Binding CommandLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" />
    </DockPanel>
   </StackPanel></Expander>
  </StackPanel>
 </Grid>
</UserControl>
