<UserControl x:Class="Sortopia.WPF.Views.Pages.ResultsExecution.ResultsExecutionPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{DynamicResource Workspace.TextPrimary}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <StackPanel>
  <TextBlock Text="Run parameter files" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
  <DockPanel>
   <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" ToolTip="Choose a project's runParameters folder" />
   <TextBox Text="{Binding Folder, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Run parameters folder" />
  </DockPanel>
  <TextBlock Text="Run filter" Margin="0,10,0,4" Foreground="{StaticResource Workspace.TextSecondary}" />
  <ComboBox x:Name="RunFilterInput" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseRun}" AutomationProperties.Name="Filter parameter files by run" />
  <WrapPanel Margin="0,10,0,4">
   <Button x:Name="ExecutePendingButton" Content="Execute pending results" Command="{Binding ExecuteCommand}" Margin="0,0,8,6" />
   <Button Content="Check outputs" Command="{Binding CheckCommand}" Margin="0,0,8,6" />
   <Button Content="Refresh files" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
   <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,6" />
  </WrapPanel>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  <TextBlock Text="{Binding Error}" Style="{StaticResource InlineError}" TextWrapping="Wrap" />
  <ListBox ItemsSource="{Binding Outputs}" MaxHeight="260" Margin="0,8,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4">
    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" /><TextBlock Text="{Binding Error}" Style="{StaticResource InlineError}" TextWrapping="Wrap" />
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Expander Header="Command line" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,10,0,0"><StackPanel>
   <TextBlock Text="On another machine, change --parameters-folder to the copied project's runParameters folder." TextWrapping="Wrap" Margin="0,6" />
   <TextBox Text="{Binding CommandLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
  </StackPanel></Expander>
  <TextBlock Text="Execute reads existing parameter files and never runs setup. Complete outputs are validated and skipped; partial work reuses valid outputs. Copy the entire project folder, including data and runParameters." TextWrapping="Wrap" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,12,0,0" />
 </StackPanel>
</UserControl>
