<UserControl x:Class="Sortopia.WPF.Views.Pages.ResultsExecution.ResultsExecutionPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{DynamicResource Workspace.TextPrimary}">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" /></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="ErrorVisibility" />
 </ResourceDictionary></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Run parameter files" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
   <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" ToolTip="Choose a project's runParameters folder" />
    <TextBox Text="{Binding Folder, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Run parameters folder" /></DockPanel>
   <TextBlock Text="Run filter" Margin="0,10,0,4" Foreground="{StaticResource Workspace.TextSecondary}" />
   <ComboBox x:Name="RunFilterInput" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseRun}" AutomationProperties.Name="Filter parameter files by run" />
   <WrapPanel Margin="0,10,0,0">
    <TextBlock Text="Parallel jobs" VerticalAlignment="Center" Margin="0,0,8,0" />
    <TextBox x:Name="ParallelJobsInput" Text="{Binding ParallelJobs, UpdateSourceTrigger=PropertyChanged}" Width="65"
             IsEnabled="{Binding CanChooseRun}" AutomationProperties.Name="Parallel jobs" ToolTip="Maximum number of parameter files to execute at once. Each job uses additional memory." />
    <TextBlock Text="{Binding ParallelJobsError}" Style="{StaticResource InlineError}" Margin="8,0,0,0" VerticalAlignment="Center" />
   </WrapPanel>
  </StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,10,0,4">
   <Button x:Name="ExecuteSelectedButton" Content="Execute selected" Command="{Binding ExecuteCommand}" Margin="0,0,8,6" />
   <Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,8,6" />
   <Button Content="Select pending" Command="{Binding SelectPendingCommand}" Margin="0,0,8,6" />
   <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,6" />
   <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
   <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,6" />
  </WrapPanel>
  <StackPanel Grid.Row="2" Margin="0,0,0,8">
   <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0" />
   <TextBlock Text="{Binding Error}" Style="{StaticResource InlineError}" TextWrapping="Wrap" />
   <TextBlock Text="Select rows with Ctrl/Shift, or use Select all. Complete outputs are reused. Each selected file must have distinct outputs. Failed jobs do not stop other selected jobs."
              Foreground="{StaticResource Workspace.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
   <TextBlock Text="Rows update as they run. Select a failed row and expand Error details to inspect or copy its error."
              Foreground="{StaticResource Workspace.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
  </StackPanel>
  <DataGrid x:Name="RunParametersGrid" Grid.Row="3" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
            IsEnabled="{Binding CanChooseRun}" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
            SelectionChanged="SelectionChanged" HeadersVisibility="All" FrozenColumnCount="2" MinHeight="140"
            AreRowDetailsFrozen="True" RowDetailsVisibilityMode="VisibleWhenSelected"
            EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
            AutomationProperties.Name="Run parameter files and output status">
   <DataGrid.RowStyle><Style TargetType="DataGridRow">
    <Setter Property="ToolTip" Value="{Binding Error}" />
   </Style></DataGrid.RowStyle>
   <DataGrid.RowDetailsTemplate><DataTemplate>
    <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}" Padding="8,2,36,6" HorizontalAlignment="Left"
            Visibility="{Binding HasError, Converter={StaticResource ErrorVisibility}}">
     <Expander Header="Error details" Foreground="{StaticResource Workspace.TextPrimary}" AutomationProperties.Name="Run parameter error details">
      <TextBox Text="{Binding Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Run parameter error" Margin="0,6,0,0" />
     </Expander>
    </Border>
   </DataTemplate></DataGrid.RowDetailsTemplate>
  </DataGrid>
  <StackPanel Grid.Row="4">
   <Expander Header="Command line for selected files" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,10,0,0"><StackPanel>
    <TextBlock Text="On another machine, use paths inside the copied project's runParameters folder." TextWrapping="Wrap" Margin="0,6" />
    <TextBox Text="{Binding CommandLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" />
   </StackPanel></Expander>
   <TextBlock Text="Execution uses these saved files and never runs setup. Copy the entire project folder, including data and runParameters, for execution elsewhere."
              TextWrapping="Wrap" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,10,0,0" />
  </StackPanel>
 </Grid>
</UserControl>
