<UserControl x:Class="Sortopia.WPF.Views.Pages.ResultsExecution.ResultsExecutionPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Sortopia.WPF.Views.Pages.ResultsExecution" AutomationProperties.Name="Results execution">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer Background="{StaticResource Workspace.Canvas}" Foreground="{StaticResource Workspace.TextPrimary}" VerticalScrollBarVisibility="Auto" Padding="20">
  <StackPanel>
   <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="← Back to Sortopia" Command="{Binding ReturnCommand}" Style="{StaticResource PageReturnButtonStyle}" />
    <TextBlock Text="Results execution" FontSize="24" FontWeight="SemiBold" /></DockPanel>
   <Border Background="{StaticResource Workspace.Surface}" Padding="20" CornerRadius="8"><local:ResultsExecutionPanel /></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
