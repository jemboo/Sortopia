<UserControl x:Class="Sortopia.WPF.Views.Pages.ResultsExecution.ResultsExecutionPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Sortopia.WPF.Views.Pages.ResultsExecution" AutomationProperties.Name="Results execution">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Background="{StaticResource Workspace.Canvas}" Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="{Binding ReturnLabel}" Command="{Binding ReturnCommand}" Style="{StaticResource PageReturnButtonStyle}" />
    <TextBlock Text="Results execution" Foreground="{StaticResource Workspace.TextPrimary}" FontSize="24" FontWeight="SemiBold" /></DockPanel>
   <Border Grid.Row="1" Background="{StaticResource Workspace.Surface}" Padding="20" CornerRadius="8"><local:ResultsExecutionPanel x:Name="ExecutionPanel" /></Border>
 </Grid>
</UserControl>
