<UserControl x:Class="Sortopia.WPF.Views.NetworksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sortopia.WPF.Controls"
             AutomationProperties.Name="Sorting networks page" Foreground="{DynamicResource Workspace.TextPrimary}">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Workspace.TextPrimary}" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource NetworkComboBoxStyle}" />
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Workspace.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PageRows" Background="{StaticResource Workspace.Canvas}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="←" Command="{Binding ReturnHomeCommand}" Margin="8,0,0,8"
                    VerticalAlignment="Top" ToolTip="Back to Sortopia" AutomationProperties.Name="Back to Sortopia" />
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                    <Label Content="_Network" Target="{Binding ElementName=NetworkPicker}" />
                    <ComboBox x:Name="NetworkPicker" Width="220" ItemsSource="{Binding Networks}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedNetwork}" AutomationProperties.Name="Network" />
                </StackPanel>
                <TextBlock Text="{Binding CountsSummary}" VerticalAlignment="Center" Margin="0,0,18,8" />
                <CheckBox Content="Binary inputs (0–1)" IsChecked="{Binding UseZeroOneRule}"
                          Foreground="{StaticResource Workspace.TextPrimary}" VerticalAlignment="Center" Margin="0,0,18,8"
                          AutomationProperties.Name="Binary inputs (0–1)"
                          ToolTip="The 0–1 principle: a network that sorts every binary input sorts any ordered values. New input draws one binary example." />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <Label Content="_Zoom" Target="{Binding ElementName=ZoomSlider}" />
                    <Slider x:Name="ZoomSlider" Width="90" Minimum="1" Maximum="3" Value="{Binding ZoomFactor}"
                            SmallChange="0.1" LargeChange="0.5" AutomationProperties.Name="Diagram zoom"
                            ToolTip="Fit at the left end; move right to enlarge the network." />
                    <TextBlock Text="{Binding ZoomLabel}" Width="32" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </WrapPanel>
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
            <Button Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" MinWidth="72" Margin="0,0,10,0"
                    Style="{StaticResource PrimaryAction}" AutomationProperties.Name="Play or pause"
                    ToolTip="Play starts a different random input from stage 0, keeping CE colors. Pause stops the animation." />
            <Button Content="New input" Command="{Binding NewInputCommand}" AutomationProperties.Name="New input"
                    ToolTip="Shuffle the input and return to stage 0, keeping CE colors." />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,20,0">
                <Label Content="_Speed" Target="{Binding ElementName=SpeedSlider}" />
                <Slider x:Name="SpeedSlider" Width="100" Minimum="0.25" Maximum="3" Value="{Binding Speed}"
                        SmallChange="0.25" AutomationProperties.Name="Playback speed" ToolTip="Playback speed" />
            </StackPanel>
            <Button Content="Reset colors" Command="{Binding ResetColorsCommand}" AutomationProperties.Name="Reset colors"
                    ToolTip="Clear CE color history. The input and playback position stay where they are." />
        </WrapPanel>

        <Border Grid.Row="2" BorderBrush="{StaticResource Workspace.StrokeSubtle}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer x:Name="DiagramViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Padding="12" AutomationProperties.Name="Network diagram viewport">
                    <controls:NetworkDiagram x:Name="Diagram" Trace="{Binding Trace}" UseZeroOneRule="{Binding UseZeroOneRule}"
                                             Position="{Binding Position}" ByStage="{Binding ByStage}" ComparatorStates="{Binding ComparatorStates}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ScrollViewer>
                <WrapPanel Grid.Row="1" Margin="12,6,12,10" AutomationProperties.Name="CE color legend">
                    <TextBlock Text="CE colors" FontSize="12" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,0,14,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <Rectangle Width="14" Height="4" Fill="#56C7B4" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Swapped" FontSize="12" ToolTip="Swapped values at least once since Reset colors." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <Rectangle Width="14" Height="4" Fill="#4A586D" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Compared, no swap" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="14" Height="4" Fill="#829AA6" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Not yet compared" FontSize="12" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
