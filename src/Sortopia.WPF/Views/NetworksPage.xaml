<UserControl x:Class="Sortopia.WPF.Views.NetworksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sortopia.WPF.Controls"
             AutomationProperties.Name="Sorting networks page">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DBE8EF" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource NetworkComboBoxStyle}" />
    </UserControl.Resources>
    <Grid Background="#102B3B" Margin="0">
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Height="{Binding ViewportHeight, ElementName=PageScroll}" MinHeight="660">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Content="← _Back to Sortopia" Command="{Binding ReturnHomeCommand}"
                        Margin="16,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Back to Sortopia" />
                <StackPanel>
                    <TextBlock Text="Sorting networks" FontSize="30" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Follow the values through the catalog." Foreground="#9FBECC" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <WrapPanel Grid.Row="1" Margin="0,0,0,16">
                <StackPanel Margin="0,0,24,8">
                    <Label Content="_Network" Target="{Binding ElementName=NetworkPicker}" Foreground="#9FBECC" Padding="0,0,0,6" />
                    <ComboBox x:Name="NetworkPicker" Width="250" ItemsSource="{Binding Networks}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedNetwork}" AutomationProperties.Name="Network" />
                </StackPanel>
                <StackPanel Margin="0,0,24,8">
                    <TextBlock Text="Input" Foreground="#9FBECC" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Shuffle" Command="{Binding ShuffleCommand}" AutomationProperties.Name="Shuffle input" />
                        <Button Content="Reverse" Command="{Binding ReverseCommand}" AutomationProperties.Name="Reverse input" />
                        <CheckBox Content="0–1 rule" IsChecked="{Binding UseZeroOneRule}" Foreground="#DBE8EF"
                                  VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.Name="Use 0–1 rule"
                                  ToolTip="Sort binary inputs (zeros and ones). Shuffle generates a new binary input; Reverse puts ones before zeros." />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding NetworkSummary}" VerticalAlignment="Center" Margin="0,12,0,0" Foreground="#DBE8EF" FontWeight="SemiBold" />
            </WrapPanel>

            <Border Grid.Row="2" Background="#1B3E50" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="Reset" Command="{Binding ResetCommand}" AutomationProperties.Name="Reset playback" />
                    <Button Content="Previous" Command="{Binding PreviousCommand}" AutomationProperties.Name="Previous step" />
                    <Button Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" MinWidth="72"
                            Background="#2C6570" AutomationProperties.Name="Play or pause" />
                    <Button Content="Next" Command="{Binding NextCommand}" AutomationProperties.Name="Next step" />
                    <ComboBox Width="126" ItemsSource="{Binding StepModes}" SelectedIndex="{Binding StepMode}"
                              Margin="8,2,18,2" AutomationProperties.Name="Step mode" ToolTip="Step through individual comparators or complete stages" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,16,6">
                        <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider Width="80" Minimum="0.25" Maximum="3" Value="{Binding Speed}" SmallChange="0.25"
                                AutomationProperties.Name="Playback speed" ToolTip="Playback speed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,6">
                        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider Width="80" Minimum="0.4" Maximum="1.5" Value="{Binding Zoom}" SmallChange="0.1"
                                AutomationProperties.Name="Diagram zoom" ToolTip="Zoom the network; scroll to see larger networks" />
                    </StackPanel>
                    <CheckBox Content="Follow" IsChecked="{Binding FollowPlayback}" Foreground="#DBE8EF"
                              VerticalAlignment="Center" Margin="14,6,0,6" AutomationProperties.Name="Follow playback"
                              ToolTip="Keep the animated values in view horizontally" />
                </WrapPanel>
            </Border>

            <Border Grid.Row="3" BorderBrush="#345464" BorderThickness="1" CornerRadius="8" Background="#102B3B">
                <ScrollViewer x:Name="DiagramViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Padding="12" AutomationProperties.Name="Network diagram viewport">
                    <controls:NetworkDiagram x:Name="Diagram" Trace="{Binding Trace}" UseZeroOneRule="{Binding UseZeroOneRule}" Position="{Binding Position}" ByStage="{Binding ByStage}" Zoom="{Binding Zoom}"
                                             HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="4" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Margin="16,0,0,0" MinWidth="132" TextAlignment="Right" />
                    <Slider Minimum="0" Maximum="{Binding StepCount}" Value="{Binding SeekPosition, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                            AutomationProperties.Name="Playback position" ToolTip="Seek to any recorded step" />
                </DockPanel>
                <TextBlock Text="{Binding CurrentValuesText}" FontFamily="Consolas" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock Text="Gold: next comparison · Teal: swapped · Muted: no swap. Colored channels match destination values; 0–1 balls are black and white."
                           Foreground="#9FBECC" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
