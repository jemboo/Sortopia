<UserControl x:Class="Sortopia.WPF.Views.Shared.Controls.StageLayoutSelector" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Stage layout">
    <UserControl.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Workspace.TextPrimary}" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="{DynamicResource Workspace.Surface}" BorderBrush="{DynamicResource Workspace.Stroke}"
                                BorderThickness="1" CornerRadius="4" Padding="10,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Workspace.SurfaceSelected}" /><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <WrapPanel>
        <RadioButton x:Name="AllCes" Content="1 All CEs" Tag="0" IsChecked="True" Checked="ModeChecked" ToolTip="Show the original network." />
        <RadioButton x:Name="UsedStages" Content="2 Used stages" Tag="1" Checked="ModeChecked" IsEnabled="{Binding HasTestResults, ElementName=Root}"
                     ToolTip="Hide stages with no swaps; keep all CEs in the remaining stages." ToolTipService.ShowOnDisabled="True" />
        <RadioButton x:Name="UsedCes" Content="3 Used CEs" Tag="2" Checked="ModeChecked" IsEnabled="{Binding HasTestResults, ElementName=Root}"
                     ToolTip="Show only CEs that swapped values during testing, in their original stages." ToolTipService.ShowOnDisabled="True" />
        <RadioButton x:Name="Compact" Content="4 Compact" Tag="3" Checked="ModeChecked" IsEnabled="{Binding HasTestResults, ElementName=Root}"
                     ToolTip="Show used CEs packed into fewer stages. The original network is preserved." ToolTipService.ShowOnDisabled="True" />
    </WrapPanel>
</UserControl>
