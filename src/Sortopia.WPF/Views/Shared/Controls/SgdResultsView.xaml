<UserControl x:Class="Sortopia.WPF.Views.Shared.Controls.SgdResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sortopia.WPF.Views.Shared.Controls"
             Foreground="{DynamicResource Workspace.TextPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AutomationProperties.Name="Sgd Results View">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sortopia.WPF;component/Styles/SgdWorkspace.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="GraphAnnotationContent">
                <StackPanel Orientation="Horizontal" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                    <TextBlock Text="{Binding Name}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSorter}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text=": [" />
                        <!-- Reserve three CE digits and two stage digits, even before a sorter is available. -->
                        <TextBlock Text="{Binding Position.X, StringFormat=0, FallbackValue=—}" Width="24"
                                   TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text=", " />
                        <TextBlock Text="{Binding Position.Y, StringFormat=0, FallbackValue=—}" Width="16"
                                   TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="]" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="82" />
            <RowDefinition Height="8" />
            <RowDefinition Height="1.45*" MinHeight="75" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Visibility="{Binding ShowResultPanes, Converter={StaticResource BoolVisibility}}" Background="{StaticResource Workspace.Surface}" BorderBrush="{StaticResource Workspace.StrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="10">
            <DockPanel x:Name="NetworkViewer" Visibility="{Binding ShowResultPanes, Converter={StaticResource BoolVisibility}}">
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Workspace.StrokeSubtle}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox x:Name="NetworkLayoutViewport" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <controls:StageLayoutSelector x:Name="StageLayouts" Mode="{Binding DisplayMode}" HasTestResults="True" />
                        </Viewbox>
                        <Viewbox x:Name="NetworkNavigationViewport" Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center" DataContext="{Binding NetworkHistory}" ToolTip="{Binding Current.Description}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="MinHeight" Value="24" />
                                        <Setter Property="FontSize" Value="11" />
                                    </Style>
                                </StackPanel.Resources>
                                <Button Content="←" Command="{Binding PreviousCommand}" AutomationProperties.Name="Previous network" Padding="6,3" Margin="0,0,4,0" />
                                <TextBox x:Name="NetworkIndex" Text="{Binding IndexText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasEntries}" MinWidth="22" MaxWidth="64" MinHeight="20" Height="20" Padding="3,1" FontSize="10" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Network list index" ToolTip="Enter a network number and press Enter or Tab to jump to it." GotKeyboardFocus="IndexGotFocus" LostKeyboardFocus="IndexLostFocus" PreviewKeyDown="IndexKeyDown" />
                                <TextBlock Text="{Binding Entries.Count, StringFormat=' / {0}'}" FontSize="10" Foreground="{StaticResource Workspace.TextPrimary}" VerticalAlignment="Center" Margin="2,0,4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Position}" Value="Graph">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="→" Command="{Binding NextCommand}" AutomationProperties.Name="Next network" Padding="6,3" Margin="0" />
                                <Button Content="Follow live" Command="{Binding FollowLiveCommand}" Padding="6,3" Margin="4,0,0,0" ToolTip="Return to the latest draw or Evolution parent and follow new results." />
                            </StackPanel>
                        </Viewbox>
                        <Viewbox x:Name="UsageLegendViewport" Grid.Column="1" Margin="15,0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="UsageLegendTitle" Text="CE swap frequency" FontSize="10" Foreground="{StaticResource Workspace.TextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding UsageBands}" AutomationProperties.Name="CE swap percentage legend">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Fill}" Padding="3,2" MinWidth="24" ToolTip="{Binding Description}">
                                                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Viewbox>
                    </Grid>
                </Border>
                <Canvas x:Name="DiagramHost">
                    <ScrollViewer Width="{Binding ActualWidth, ElementName=DiagramHost}" Height="{Binding ActualHeight, ElementName=DiagramHost}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Left">
                            <controls:NetworkDiagram x:Name="SwitchDiagram" DisplayMode="{Binding DisplayMode}" StaticNetwork="{Binding Network}" Usage="{Binding DisplayUsage}" />
                        </Viewbox>
                    </ScrollViewer>
                </Canvas>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Workspace.StrokeSubtle}" Cursor="SizeNS" AutomationProperties.Name="Resize network and graph panes" />
        <Border x:Name="ResultsGraph" Grid.Row="2" Visibility="{Binding ShowResultPanes, Converter={StaticResource BoolVisibility}}" BorderBrush="{StaticResource Workspace.StrokeSubtle}" BorderThickness="1" CornerRadius="8" Padding="4" Background="{StaticResource Workspace.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="80" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="3*" MinWidth="100" />
                </Grid.ColumnDefinitions>
                <Viewbox x:Name="GraphControlsViewport" Margin="0,0,4,0" Stretch="Uniform" VerticalAlignment="Top">
                    <Border BorderBrush="{StaticResource Workspace.StrokeSubtle}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <StackPanel>
                            <ItemsControl x:Name="AnnotationToggles" ItemsSource="{Binding Annotations}" MaxWidth="{Binding ActualWidth, ElementName=GraphBuffersPanel}" HorizontalAlignment="Left" AutomationProperties.Name="Annotated sorters">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Content="{Binding Label}" ContentTemplate="{StaticResource GraphAnnotationContent}"
                                                      AutomationProperties.Name="{Binding Label}" FontSize="12" Foreground="{Binding Brush}"
                                                      IsEnabled="{Binding HasSorter}" IsChecked="{Binding IsShown, Mode=TwoWay}" Padding="5,2" Margin="0,0,3,3">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource GraphBufferToggle}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding Name}" Value="Best">
                                                            <Setter Property="ToolTip" Value="Lowest size score among visible zero-failure sorters." />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Name}" Value="Current">
                                                            <Setter Property="ToolTip" Value="{Binding DataContext.Summary, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="GraphBuffersPanel" Background="{StaticResource Workspace.Surface}" BorderBrush="{StaticResource Workspace.StrokeSubtle}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Graph buffers" ToolTip="Toggle a buffer to show or hide its points. Hidden buffers keep recording. sd is the population standard deviation.">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,4">
                                        <TextBlock Text="Count" VerticalAlignment="Center" />
                                        <ToggleButton x:Name="StatsPopulationToggle" IsChecked="{Binding ShowVisitStats, Mode=TwoWay}" Opacity="1" AutomationProperties.Name="Count visits" ToolTip="Unique counts each sorter once per buffer tile and once per graph point across all visible buffers. Visits includes repeats.">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource GraphBufferToggle}">
                                                    <Setter Property="Content" Value="Unique" />
                                                    <Setter Property="Padding" Value="5,1" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="Visits" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <TextBlock Text="Measure" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <ToggleButton x:Name="StatsMeasureToggle" IsChecked="{Binding ShowStageStats, Mode=TwoWay}" Opacity="1" AutomationProperties.Name="Measure stages" ToolTip="Switch between compacted CE counts and stage counts.">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource GraphBufferToggle}">
                                                    <Setter Property="Content" Value="CEs" />
                                                    <Setter Property="Padding" Value="5,1" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="Stages" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </WrapPanel>
                                    <Grid HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="1" Text="Successful" Foreground="{StaticResource Workspace.Accent}" FontSize="11" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="Failures" Foreground="{StaticResource Workspace.Warning}" FontSize="11" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Clear" FontSize="11" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="{Binding FirstGroup.Name}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Grid.Row="2" Text="{Binding SecondGroup.Name}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <ToggleButton x:Name="ParentSuccessToggle" Grid.Row="1" Grid.Column="1" Style="{StaticResource GraphStatsToggle}" DataContext="{Binding FirstGroup.Success}" AutomationProperties.Name="{Binding DataContext.FirstGroup.Name, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Show {0} successes'}" />
                                        <ToggleButton x:Name="ParentFailureToggle" Grid.Row="1" Grid.Column="2" Style="{StaticResource GraphStatsToggle}" DataContext="{Binding FirstGroup.Failure}" AutomationProperties.Name="{Binding DataContext.FirstGroup.Name, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Show {0} failures'}" />
                                        <ToggleButton x:Name="ChildSuccessToggle" Grid.Row="2" Grid.Column="1" Style="{StaticResource GraphStatsToggle}" DataContext="{Binding SecondGroup.Success}" AutomationProperties.Name="{Binding DataContext.SecondGroup.Name, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Show {0} successes'}" />
                                        <ToggleButton x:Name="ChildFailureToggle" Grid.Row="2" Grid.Column="2" Style="{StaticResource GraphStatsToggle}" DataContext="{Binding SecondGroup.Failure}" AutomationProperties.Name="{Binding DataContext.SecondGroup.Name, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Show {0} failures'}" />
                                        <Button x:Name="ClearFirstGroup" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Padding="5,2" Margin="3,0,0,0" Command="{Binding ClearGroupCommand}" CommandParameter="{Binding FirstGroup}" AutomationProperties.Name="{Binding FirstGroup.Name, StringFormat='Clear {0}'}">
                                            <TextBlock Text="{Binding FirstGroup.Name, StringFormat='Clear {0}'}" />
                                        </Button>
                                        <Button x:Name="ClearSecondGroup" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Padding="5,2" Margin="3,0,0,0" Command="{Binding ClearGroupCommand}" CommandParameter="{Binding SecondGroup}" AutomationProperties.Name="{Binding SecondGroup.Name, StringFormat='Clear {0}'}">
                                            <TextBlock Text="{Binding SecondGroup.Name, StringFormat='Clear {0}'}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="4,6,4,0" ToolTip="When the maximum visible count is 1, the scale starts at red. For larger maxima, the scale starts at blue and reaches red when counts vary.">
                                <TextBlock x:Name="PlotLegendTitle" Text="{Binding PlotLegendTitle}" />
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Rectangle x:Name="PlotLegendScale" Grid.ColumnSpan="2" Height="10">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="{x:Static controls:EvolutionPlot.FrequencyLegend}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlotData.HasColorRange}" Value="False">
                                                        <Setter Property="Fill" Value="Blue" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PlotData.Maximum}" Value="1">
                                                        <Setter Property="Fill" Value="Red" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PlotData.Maximum}" Value="0">
                                                        <Setter Property="Fill" Value="Transparent" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Grid.Row="1" Text="{Binding PlotData.Minimum, StringFormat='Min {0:N0}'}" />
                                    <TextBlock x:Name="PlotLegendMax" Grid.Row="1" Grid.Column="1" TextAlignment="Right" Text="{Binding PlotData.Maximum, StringFormat='Max {0:N0}'}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Viewbox>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Workspace.StrokeSubtle}" Cursor="SizeWE" AutomationProperties.Name="Resize graph controls and plot" ToolTip="Resize graph controls and plot" />
                <Viewbox x:Name="PlotViewport" Grid.Column="2" Stretch="Uniform">
                    <controls:EvolutionPlot AllBufferBounds="{Binding AllBufferBounds}" SelectedPosition="{Binding GraphSelectionPosition}" SelectPointCommand="{Binding SelectGraphPointCommand}" Visits="{Binding PlotData}" FillHighlightMarkers="{Binding ShowVisitStats}" BestPosition="{Binding BestAnnotation.VisiblePosition}" ShowCurrent="{Binding CurrentAnnotation.IsShown}" BestKnownNetworks="{Binding VisibleCatalogNetworks}" AutomationProperties.Name="Evolution lattice, CE count horizontally and stage count vertically, equally scaled" />
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
