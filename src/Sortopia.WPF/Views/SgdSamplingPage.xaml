<UserControl x:Class="Sortopia.WPF.Views.SgdSamplingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Sortopia.WPF.Controls" xmlns:views="clr-namespace:Sortopia.WPF.Views" xmlns:vm="clr-namespace:Sortopia.WPF.ViewModels" xmlns:sys="clr-namespace:System;assembly=mscorlib" Foreground="{DynamicResource Workspace.TextPrimary}" UseLayoutRounding="True" SnapsToDevicePixels="True" AutomationProperties.Name="Sgd Sampling Page">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sortopia.WPF;component/Styles/SgdWorkspace.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.3*" MinHeight="45" />
            <RowDefinition Height="8" />
            <RowDefinition Height="2.45*" MinHeight="165" />
        </Grid.RowDefinitions>
        <Grid x:Name="SettingsArea" Grid.Row="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowResultPanes}" Value="False">
                            <Setter Property="Grid.RowSpan" Value="3" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource ControlGroup}">
                <Grid Margin="2,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox x:Name="SettingsViewport" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel AutomationProperties.Name="Generation settings" IsEnabled="{Binding CanEdit}">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} Channels · {1}">
                                            <Binding Path="Generator.ChannelCount" />
                                            <Binding Path="Generator.Method" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Store run in" Target="{Binding ElementName=SamplingDestination}" Style="{StaticResource FieldLabel}" />
                                        <ToggleButton x:Name="SamplingDestination" IsChecked="{Binding SampleToB, Mode=TwoWay}" Height="{StaticResource SetupSamplingControlHeight}" Margin="0" Opacity="1" Background="{StaticResource Workspace.SurfaceSelected}" BorderBrush="{StaticResource Workspace.Accent}" AutomationProperties.Name="Sampling destination B" ToolTip="Switch between A and B before starting a sampling run.">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource GraphBufferToggle}">
                                                    <Setter Property="Content" Value="Buffer A" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="Buffer B" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Random source" Target="{Binding ElementName=SourcePicker}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="SourcePicker" Width="112" Height="{StaticResource SetupSamplingControlHeight}" ItemsSource="{Binding GenerationOptions.RandomSources}" SelectedItem="{Binding GenerationOptions.RandomSource}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Random seed" Target="{Binding ElementName=SeedInput}" Style="{StaticResource FieldLabel}" />
                                        <Grid Width="132" Height="{StaticResource SetupSamplingControlHeight}">
                                            <TextBox x:Name="SeedInput" Padding="8,4,34,4" Text="{Binding Generator.SeedText, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Command="{Binding NewSeedCommand}" Style="{StaticResource NewSeedButtonStyle}" Height="Auto" VerticalAlignment="Stretch" ToolTip="Choose a new random seed." />
                                        </Grid>
                                    </StackPanel>
                                    <CheckBox Content="Exclude self CEs" IsChecked="{Binding GenerationOptions.ExcludeSelf}" Height="{StaticResource SetupSamplingControlHeight}" VerticalContentAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="{Binding GenerationOptions.CanExcludeSelf, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource Workspace.TextPrimary}" />
                                </WrapPanel>
                                <StackPanel Visibility="{Binding GenerationOptions.HasDistributions, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="Relative weights" Style="{StaticResource SectionTitle}" Margin="0,4" />
                                    <ItemsControl x:Name="GenerationWeightTables" ItemsSource="{Binding GenerationOptions.WeightTables}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:ParamEditor2d Margin="0,0,0,5" AutomationProperties.Name="Generator weights" ToolTip="Weights in each row are normalized to probabilities. Zero excludes a mode." />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Viewbox>
                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Workspace.Stroke}" Padding="10,0,0,0">
                        <Viewbox x:Name="OutputViewport" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel Width="320">
                                <StackPanel AutomationProperties.Name="Generation output">
                                    <WrapPanel Margin="0,0,0,4">
                                        <Button x:Name="MakeOneButton" Style="{StaticResource PrimaryAction}" Content="Make one" Command="{Binding GenerateCommand}" Margin="0,0,4,3" ToolTip="Choose a new random seed and make one sorter." />
                                        <Button x:Name="BatchButton" Content="Batch" Command="{Binding BatchCommand}" Margin="0,0,4,3" ToolTip="Start with the displayed seed and keep sampling fresh seeds until stopped." />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource StopAction}" Content="Stop" Command="{Binding StopCommand}" Margin="0,0,4,3" />
                                            <Button x:Name="EvolveButton" Content="Evolve" Command="{Binding EvolveSelectionCommand}" Margin="0,0,0,3" ToolTip="Open Evolution with the selected sample as the parent." />
                                        </StackPanel>
                                    </WrapPanel>
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Success / Failures" Content="{Binding GenerationOutcomes}" ToolTip="Generated sorters since Clear. A success passes every input tested in its draw." />
                                    <TextBlock Text="Last generated sorter" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <StackPanel DataContext="{Binding GenerationResult}">
                                        <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Test inputs" Content="{Binding Inputs, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                        <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Coverage" Content="{Binding Coverage, TargetNullValue=—, FallbackValue=—}" />
                                        <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Method" Content="{Binding Method, TargetNullValue=—, FallbackValue=—}" />
                                        <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Channels" Content="{Binding Channels, TargetNullValue=—, FallbackValue=—}" />
                                        <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Stages" Content="{Binding Stages, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                        <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Seed" Content="{Binding Seed, TargetNullValue=—, FallbackValue=—}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Generator.SeedError}" Style="{StaticResource InlineError}" />
                                    <TextBlock Text="{Binding GenerationOptions.Error}" Style="{StaticResource InlineError}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource InlineError}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Visibility="{Binding ShowResultPanes, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Workspace.StrokeSubtle}" Cursor="SizeNS" AutomationProperties.Name="Resize settings and network panes" />
        <views:SgdResultsView x:Name="Results" Grid.Row="2" Visibility="{Binding ShowResultPanes, Converter={StaticResource BoolVisibility}}" />
    </Grid>
</UserControl>