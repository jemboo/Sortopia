<UserControl x:Class="Sortopia.WPF.Views.NetworkGeneratorInputs"
             x:Name="Inputs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/Sortopia.WPF;component/Styles/NetworkWorkspace.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <WrapPanel>
            <WrapPanel.Resources>
                <Style TargetType="StackPanel"><Setter Property="IsEnabled" Value="{Binding CanEdit}" /></Style>
            </WrapPanel.Resources>
            <StackPanel Margin="0,0,10,5">
                <Label Content="_Method" Target="{Binding ElementName=MethodPicker}" Foreground="#9FBECC" Padding="0,0,0,3" />
                <ComboBox x:Name="MethodPicker" Width="96" ItemsSource="{Binding Generator.Methods}" SelectedItem="{Binding Generator.Method}" AutomationProperties.Name="Generation method" />
            </StackPanel>
            <StackPanel Margin="0,0,10,5">
                <Label Content="_Channels" Target="{Binding ElementName=ChannelPicker}" Foreground="#9FBECC" Padding="0,0,0,3" />
                <ComboBox x:Name="ChannelPicker" Width="78" ItemsSource="{Binding Generator.ChannelCounts}" SelectedItem="{Binding Generator.ChannelCount, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False" ToolTip="{Binding Generator.WidthHint}" AutomationProperties.Name="Channel count" />
            </StackPanel>
            <StackPanel Margin="0,0,10,5">
                <Label Content="{Binding Generator.CountLabel}" Target="{Binding ElementName=SizeInput}" Foreground="#9FBECC" Padding="0,0,0,3" />
                <TextBox x:Name="SizeInput" Width="135" Text="{Binding Generator.CountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Network size" />
            </StackPanel>
            <StackPanel Margin="0,0,10,5">
                <Label Content="Random _seed" Target="{Binding ElementName=SeedInput}" Foreground="#9FBECC" Padding="0,0,0,3" />
                <Grid Width="132">
                    <TextBox x:Name="SeedInput" Padding="8,4,34,4" Text="{Binding Generator.SeedText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Random seed" ToolTip="Same seed and settings reproduce the same network." />
                    <Button Command="{Binding NewSeedCommand}" Width="26" Height="24" MinHeight="0" Padding="0" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="{Binding SeedHint, ElementName=Inputs}" AutomationProperties.Name="New random seed" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Surface" Background="Transparent" CornerRadius="4" BorderBrush="Transparent" BorderThickness="1">
                                    <Path Data="M 15 6 A 6 6 0 1 0 15 12 M 15 2 L 15 6 L 11 6" Stroke="#9EDAD6" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#315D6B" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C6570" /></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F6CE83" /></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
            <StackPanel Margin="0,0,10,5">
                <Label Content="Test inputs / all" Target="{Binding ElementName=SampleInput}" Foreground="#9FBECC" Padding="0,0,0,3" />
                <TextBox x:Name="SampleInput" Width="110" Text="{Binding Generator.SamplesText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Generator.TestHint}" AutomationProperties.Name="Test sample count or all" />
            </StackPanel>
            <Button x:Name="GenerateButton" Content="{Binding GenerateLabel, ElementName=Inputs}" Command="{Binding GenerateCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=ChannelPicker}" VerticalAlignment="Bottom" Margin="0,0,6,5" />
        </WrapPanel>
        <TextBlock Text="{Binding Generator.InputError}" Style="{StaticResource InlineError}" />
        <TextBlock Text="{Binding Generator.TestInputError}" Style="{StaticResource InlineError}" />
    </StackPanel>
</UserControl>
