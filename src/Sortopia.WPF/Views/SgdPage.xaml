<UserControl x:Class="Sortopia.WPF.Views.SgdPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sortopia.WPF.Controls"
             AutomationProperties.Name="Sampling and Evolution page">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sortopia.WPF;component/Styles/NetworkWorkspace.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <SolidColorBrush x:Key="ControlText" Color="#F3F7FA" />
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#9EDAD6" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="ControlGroup" TargetType="Border">
                <Setter Property="Background" Value="#18394A" />
                <Setter Property="BorderBrush" Value="#466B7B" />
                <Setter Property="Padding" Value="8,4,8,2" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="Foreground" Value="{StaticResource ControlText}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="0,0,4,0" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource NetworkComboBoxStyle}">
                <Setter Property="Foreground" Value="{StaticResource ControlText}" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="Step1Panel" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding WizardStep}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="Step2Panel" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding WizardStep}" Value="2"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="Step3Panel" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding WizardStep}" Value="3"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style>
            <DataTemplate x:Key="GenerationWeightRow">
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="82" MaxWidth="128" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource ControlText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Slider Grid.Column="1" x:Name="WeightSlider" Minimum="0" Maximum="1" Value="{Binding Value, Mode=TwoWay}"
                            SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"
                            AutomationProperties.ItemStatus="{Binding Value, StringFormat=G3}" ToolTip="Relative weight from 0 to 1. Zero excludes this mode." />
                    <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding Value, StringFormat=G3}" Foreground="{StaticResource ControlText}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="MutationWeightRow">
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="82" MaxWidth="128" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource ControlText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Slider Grid.Column="1" x:Name="ParameterSlider" Minimum="-3" Maximum="0" Value="{Binding LogValue, Mode=TwoWay}"
                            SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"
                            AutomationProperties.ItemStatus="{Binding Value, StringFormat=G3}" ToolTip="Logarithmic scale from 0.001 to 1. Each third of the slider multiplies the value by 10." />
                    <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding Value, StringFormat=G3}" Foreground="{StaticResource ControlText}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <Style x:Key="ResultRow" TargetType="HeaderedContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="HeaderedContentControl">
                            <Border BorderBrush="#345464" BorderThickness="0,0,0,1" Padding="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" MaxWidth="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{TemplateBinding Header}" Foreground="#ADCAD6" TextWrapping="Wrap" Margin="0,0,5,0" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Content" TextElement.Foreground="{StaticResource ControlText}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="#102B3B" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition MinHeight="45">
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="0.5*" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WizardStep}" Value="2"><Setter Property="Height" Value="1.65*" /></DataTrigger>
                                <DataTrigger Binding="{Binding WizardStep}" Value="3"><Setter Property="Height" Value="1.25*" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
                <RowDefinition Height="8" />
                <RowDefinition Height="*" MinHeight="82" />
                <RowDefinition Height="8" />
                <RowDefinition Height="1.15*" MinHeight="75" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="← _Back to Sortopia" Command="{Binding ReturnHomeCommand}" Style="{StaticResource PageReturnButtonStyle}" />
                <WrapPanel AutomationProperties.Name="Wizard steps">
                    <Button Content="1  Setup" Command="{Binding SetupStepCommand}" AutomationProperties.Name="Step 1: Setup">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StepNavigationButtonStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding WizardStep}" Value="1"><Setter Property="BorderBrush" Value="#77D3C7" /><Setter Property="Background" Value="#204958" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="2  Generation" Command="{Binding GenerationStepCommand}" AutomationProperties.Name="Step 2: Generation">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StepNavigationButtonStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding WizardStep}" Value="2"><Setter Property="BorderBrush" Value="#77D3C7" /><Setter Property="Background" Value="#204958" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="3  Evolution" Command="{Binding EvolutionStepCommand}" AutomationProperties.Name="Step 3: Evolution">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StepNavigationButtonStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding WizardStep}" Value="3"><Setter Property="BorderBrush" Value="#77D3C7" /><Setter Property="Background" Value="#204958" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </DockPanel>
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource ControlGroup}">
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <StackPanel Style="{StaticResource Step1Panel}" AutomationProperties.Name="Shared settings">
                                <TextBlock Text="Shared settings" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Method" Target="{Binding ElementName=MethodPicker}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="MethodPicker" Width="96" ItemsSource="{Binding Generator.Methods}" SelectedItem="{Binding Generator.Method}" AutomationProperties.Name="Generation method" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Channels" Target="{Binding ElementName=ChannelPicker}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ChannelPicker" Width="72" ItemsSource="{Binding Generator.ChannelCounts}" SelectedItem="{Binding Generator.ChannelCount, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False" ToolTip="{Binding Generator.WidthHint}" AutomationProperties.Name="Channel count" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Stages" Target="{Binding ElementName=StagesInput}" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="StagesInput" Width="86" Text="{Binding Generator.CountText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter 1–10,000 stages to override the default for this setup. For msce this sets the equivalent comparator budget." />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Test inputs / all" Target="{Binding ElementName=SampleInput}" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SampleInput" Width="100" Text="{Binding Generator.SamplesText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Generator.TestHint}" />
                                    </StackPanel>
                                </WrapPanel>
                                <CheckBox x:Name="Avx512Picker" Content="AVX512" Foreground="{StaticResource ControlText}" Margin="0,3"
                                          IsChecked="{Binding UseAvx512}" IsEnabled="{Binding CanChooseAvx512}" ToolTip="{Binding Avx512Hint}" ToolTipService.ShowOnDisabled="True" />
                            </StackPanel>

                            <StackPanel Style="{StaticResource Step2Panel}" AutomationProperties.Name="Generation settings" IsEnabled="{Binding CanEdit}">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} Channels · {1}">
                                            <Binding Path="Generator.ChannelCount" />
                                            <Binding Path="Generator.Method" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Random source" Target="{Binding ElementName=SourcePicker}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="SourcePicker" Width="112" ItemsSource="{Binding GenerationOptions.RandomSources}" SelectedItem="{Binding GenerationOptions.RandomSource}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Random seed" Target="{Binding ElementName=SeedInput}" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SeedInput" Width="110" Text="{Binding Generator.SeedText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <CheckBox Content="Exclude self CEs" IsChecked="{Binding GenerationOptions.ExcludeSelf}" VerticalAlignment="Center" Margin="0,10,0,0"
                                              Visibility="{Binding GenerationOptions.CanExcludeSelf, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource ControlText}" />
                                </WrapPanel>
                                <StackPanel Visibility="{Binding GenerationOptions.HasDistributions, Converter={StaticResource BoolVisibility}}">
                                    <WrapPanel Margin="0,4">
                                        <Label Content="Relative weights for" Target="{Binding ElementName=DistributionPicker}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="DistributionPicker" ItemsSource="{Binding GenerationOptions.Distributions}" SelectedItem="{Binding GenerationOptions.Selected}" Width="130"
                                                  ToolTip="Weights in each group are normalized to probabilities.">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding GenerationOptions.Selected.Weights}" ItemTemplate="{StaticResource GenerationWeightRow}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Style="{StaticResource Step3Panel}" AutomationProperties.Name="Evolution settings">
                                <TextBlock Style="{StaticResource SectionTitle}" ToolTip="{Binding Mutation.Hint}" Margin="0,0,0,4">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} Channels · {1}">
                                            <Binding Path="Network.Width" />
                                            <Binding Path="Mutation.Method" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <WrapPanel Margin="0,0,0,4">
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Variant" Target="{Binding ElementName=VariantPicker}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="VariantPicker" Width="57" ItemsSource="{Binding Mutation.Variants}" SelectedItem="{Binding Mutation.Variant}" IsEnabled="{Binding CanChooseMutation}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,3">
                                        <Label Content="Children / generation" Target="{Binding ElementName=ChildrenPicker}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ChildrenPicker" Width="57" ItemsSource="{Binding ChildChoices}" SelectedItem="{Binding Children}" ToolTip="Children per generation" />
                                    </StackPanel>
                                    <CheckBox Content="Exclude self CEs" IsChecked="{Binding Mutation.ExcludeSelf}" IsEnabled="{Binding CanChooseMutation}" VerticalAlignment="Center" Margin="0,10,0,0"
                                              Visibility="{Binding Mutation.CanExcludeSelf, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource ControlText}" />
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding Mutation.Parameters}" IsEnabled="{Binding CanChooseMutation}" ItemTemplate="{StaticResource MutationWeightRow}" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="82" MaxWidth="128" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Evolution speed" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="500" TickFrequency="10" SmallChange="10" LargeChange="50" IsSnapToTickEnabled="True"
                                            Value="{Binding GenerationMilliseconds}" VerticalAlignment="Center" AutomationProperties.Name="SGD generation speed" ToolTip="{Binding SpeedLabel}" />
                                    <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding GenerationMilliseconds, StringFormat='{}{0} ms'}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="#466B7B" Padding="10,0,0,0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Step1Panel}" AutomationProperties.Name="Test plan">
                                    <TextBlock Text="Test plan" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="99% stage default" Content="{Binding Generator.StageDefaultDescription}"
                                                          ToolTip="GeneSort stage count for 99% sorter success. Estimates use the nearest measured widths for this method." />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Coverage" Content="{Binding PlannedCoverage, TargetNullValue=—, FallbackValue=—}" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Test inputs" Content="{Binding PlannedInputs, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                    <TextBlock Text="{Binding Generator.SetupError}" Style="{StaticResource InlineError}" />
                                    <TextBlock Text="{Binding Generator.TestInputError}" Style="{StaticResource InlineError}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource Step2Panel}" AutomationProperties.Name="Generation output">
                                    <WrapPanel Margin="0,0,0,4">
                                        <Button Content="New seed" Command="{Binding NewSeedCommand}" Margin="0,0,4,3" ToolTip="Choose a random seed for continuous sampling." />
                                        <Button x:Name="GenerateButton" Content="Generate" Command="{Binding GenerateCommand}" CommandParameter="{Binding SelectedItem, ElementName=ChannelPicker}" Margin="0,0,4,3" />
                                        <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,0,3" />
                                    </WrapPanel>
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Success / Failures" Content="{Binding GenerationOutcomes}"
                                                          ToolTip="Generated sorters since Clear. A success passes every input tested in its draw." />
                                    <TextBlock Text="Last generated sorter" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <StackPanel DataContext="{Binding GenerationResult}">
                                        <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Test inputs" Content="{Binding Inputs, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                        <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Coverage" Content="{Binding Coverage, TargetNullValue=—, FallbackValue=—}" />
                                        <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Method" Content="{Binding Method, TargetNullValue=—, FallbackValue=—}" />
                                        <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Channels" Content="{Binding Channels, TargetNullValue=—, FallbackValue=—}" />
                                        <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Stages" Content="{Binding Stages, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                        <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Seed" Content="{Binding Seed, TargetNullValue=—, FallbackValue=—}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Generator.SeedError}" Style="{StaticResource InlineError}" />
                                    <TextBlock Text="{Binding GenerationOptions.Error}" Style="{StaticResource InlineError}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource Step3Panel}" AutomationProperties.Name="Evolution output">
                                    <WrapPanel Margin="0,0,0,4">
                                        <Button Content="Run SGD" Command="{Binding RunSgdCommand}" Margin="0,0,4,3" />
                                        <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,0,3" />
                                    </WrapPanel>
                                    <TextBlock Text="Latest evaluation" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Generation" Content="{Binding Generation, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Failures" Content="{Binding PlottedFailures, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Test inputs" Content="{Binding Usage.Tested, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Coverage" Content="{Binding Usage.Coverage, TargetNullValue=—, FallbackValue=—}" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Stages" Content="{Binding Visits.Current.Y, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                    <HeaderedContentControl Style="{StaticResource ResultRow}" Header="Comparators" Content="{Binding Visits.Current.X, TargetNullValue=—, FallbackValue=—}" ContentStringFormat="{}{0:N0}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource InlineError}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </ScrollViewer>
            <GridSplitter Grid.Row="2" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#345464"
                          Cursor="SizeNS" AutomationProperties.Name="Resize settings and network panes" ToolTip="Resize settings and network panes" />
            <DockPanel Grid.Row="3">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock x:Name="UsageLegendTitle" Text="{Binding Network.Width, StringFormat='{}{0} channels · CE swap frequency', FallbackValue='CE swap frequency'}"
                               Foreground="#9FBECC" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding UsageBands}" Margin="0,0,0,6" AutomationProperties.Name="CE swap percentage legend">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Fill}" CornerRadius="3" Padding="7,5" MinWidth="51" Margin="0,0,3,3" ToolTip="{Binding Description}">
                                    <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Border BorderBrush="#345464" BorderThickness="1" CornerRadius="8" Padding="6">
                    <Canvas x:Name="DiagramHost">
                        <ScrollViewer Width="{Binding ActualWidth, ElementName=DiagramHost}" Height="{Binding ActualHeight, ElementName=DiagramHost}"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Left">
                                <controls:NetworkDiagram StaticNetwork="{Binding Network}" Usage="{Binding Usage}" />
                            </Viewbox>
                        </ScrollViewer>
                    </Canvas>
                </Border>
            </DockPanel>
            <GridSplitter Grid.Row="4" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#345464"
                          Cursor="SizeNS" AutomationProperties.Name="Resize network and graph panes" ToolTip="Resize network and graph panes" />
            <Border Grid.Row="5" BorderBrush="#345464" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,4,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MaxWidth="300" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding BestGraphTitle}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"
                                       ToolTip="The green square marks the lowest size score among zero-failure sorters plotted since Clear." />
                            <TextBlock Text="{Binding CurrentGraphTitle}" Foreground="HotPink" FontWeight="SemiBold" ToolTip="{Binding Summary}" />
                            <ItemsControl ItemsSource="{Binding BestKnownNetworks}" AutomationProperties.Name="Best known catalog variants">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <TextBlock Text="{Binding BestKnownTitle}" Foreground="LimeGreen" FontWeight="SemiBold"
                                               TextWrapping="Wrap" ToolTip="Green dashed square: reference network from the sorting catalog." />
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Margin="0,10,0,0" ToolTip="Blue marks the least visited cells. Colors progress through cyan, green, yellow and orange to red for the most visited cells. Equal counts across the graph use blue.">
                                <TextBlock Text="Plot count (log scale)" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Rectangle Width="72" Height="10" VerticalAlignment="Center" Fill="{x:Static controls:EvolutionPlot.FrequencyLegend}" />
                                    <TextBlock Text="{Binding Visits.Maximum, StringFormat='Max {0:N0}'}" Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Clear" Command="{Binding ClearGraphCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    AutomationProperties.Name="Clear graph" ToolTip="Clear the plotted history" />
                        </StackPanel>
                    </ScrollViewer>
                    <Canvas Grid.Column="1" x:Name="PlotHost">
                        <ScrollViewer x:Name="PlotScroll" Width="{Binding ActualWidth, ElementName=PlotHost}" Height="{Binding ActualHeight, ElementName=PlotHost}"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                      ScrollChanged="CenterPlotOnResize">
                            <controls:EvolutionPlot Visits="{Binding Visits}" BestPosition="{Binding BestPosition}" BestKnownNetworks="{Binding BestKnownNetworks}"
                                                    ViewportWidth="{Binding ViewportWidth, ElementName=PlotScroll}"
                                                    HorizontalOffset="{Binding HorizontalOffset, ElementName=PlotScroll}"
                                                    AutomationProperties.Name="Evolution lattice, CE count horizontally and stage count vertically, equally scaled" />
                        </ScrollViewer>
                    </Canvas>
                </Grid>
            </Border>
            <TextBlock Grid.Row="6" Text="SGD ranks by failures, then by size (CEs + 1.1 × stages). Graph Best is the smallest score among sorters with zero failures on their tested inputs." Foreground="#9FBECC" TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
