<UserControl x:Class="Sortopia.WPF.Views.SgdPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sortopia.WPF.Controls"
             xmlns:views="clr-namespace:Sortopia.WPF.Views"
             AutomationProperties.Name="Sampling and Evolution page">
    <UserControl.Resources>
        <ResourceDictionary Source="/Sortopia.WPF;component/Styles/NetworkWorkspace.xaml" />
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScroll" Background="#102B3B" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border MinHeight="{Binding ViewportHeight, ElementName=PageScroll}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="155" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" MinHeight="185" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="← _Back to Sortopia" Command="{Binding ReturnHomeCommand}" />
                        <TextBlock Text="Sampling and Evolution" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                    </DockPanel>
                    <views:NetworkGeneratorInputs GenerateLabel="{Binding GenerateLabel}"
                        SeedHint="Choose a new random seed, then press Generate to sample continuously." />
                    <WrapPanel Margin="0,8,0,4">
                        <Label Content="Children per generation" Target="{Binding ElementName=ChildrenPicker}" Foreground="#9FBECC" />
                        <ComboBox x:Name="ChildrenPicker" ItemsSource="{Binding ChildChoices}" SelectedItem="{Binding Children}"
                                  Width="65" Margin="0,0,8,4" AutomationProperties.Name="Children per generation" />
                        <Label Content="Mutation rate" Target="{Binding ElementName=RatePicker}" Foreground="#9FBECC" />
                        <ComboBox x:Name="RatePicker" ItemsSource="{Binding RateChoices}" SelectedItem="{Binding MutationRate}"
                                  Width="88" Margin="0,0,16,4" AutomationProperties.Name="Mutation rate">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=0.###%}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox x:Name="Avx512Picker" Content="AVX512" IsChecked="{Binding UseAvx512, Mode=TwoWay}" IsEnabled="{Binding CanChooseAvx512}"
                                  Foreground="White" VerticalAlignment="Center" Margin="0,0,16,4"
                                  ToolTip="{Binding Avx512Hint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="AVX512 evaluation" />
                        <Button Content="Run SGD" Command="{Binding RunSgdCommand}" Margin="0,0,8,4" />
                        <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,8,4" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Generation, StringFormat='Generation {0:N0}'}" FontWeight="SemiBold" FontSize="17" Margin="0,0,20,0" />
                        <TextBlock Text="Evolution speed" VerticalAlignment="Center" />
                        <Slider Minimum="0" Maximum="500" TickFrequency="10" SmallChange="10" LargeChange="50" IsSnapToTickEnabled="True"
                                Value="{Binding GenerationMilliseconds}" Width="130" VerticalAlignment="Center" Margin="8,0"
                                AutomationProperties.Name="SGD generation speed" ToolTip="Target time per generation, from no delay to 500 ms" />
                        <TextBlock Text="{Binding SpeedLabel}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status}" Foreground="#F4CA7F" Margin="0,3,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBlock x:Name="UsageLegendTitle" Text="{Binding Network.Width, StringFormat='{}{0} channels · CE swap frequency', FallbackValue='CE swap frequency'}"
                                   Foreground="#9FBECC" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding UsageBands}" Margin="0,0,0,6" AutomationProperties.Name="CE swap percentage legend">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Fill}" CornerRadius="3" Padding="7,5" MinWidth="51" Margin="0,0,3,3" ToolTip="{Binding Description}">
                                        <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border BorderBrush="#345464" BorderThickness="1" CornerRadius="8" Padding="6">
                        <Canvas x:Name="DiagramHost">
                            <ScrollViewer Width="{Binding ActualWidth, ElementName=DiagramHost}" Height="{Binding ActualHeight, ElementName=DiagramHost}"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <Viewbox Stretch="Uniform" HorizontalAlignment="Left">
                                    <controls:NetworkDiagram StaticNetwork="{Binding Network}" Usage="{Binding Usage}" />
                                </Viewbox>
                            </ScrollViewer>
                        </Canvas>
                    </Border>
                </DockPanel>
                <GridSplitter Grid.Row="2" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#345464"
                              Cursor="SizeNS" AutomationProperties.Name="Resize network and graph panes" ToolTip="Resize network and graph panes" />
                <Border Grid.Row="3" BorderBrush="#345464" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,4,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MaxWidth="300" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="{Binding BestGraphTitle}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"
                                           ToolTip="The green square marks the lowest size score among zero-failure sorters plotted since Clear." />
                                <TextBlock Text="{Binding CurrentGraphTitle}" Foreground="HotPink" FontWeight="SemiBold" ToolTip="{Binding Summary}" />
                                <ItemsControl ItemsSource="{Binding BestKnownNetworks}" AutomationProperties.Name="Best known catalog variants">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <TextBlock Text="{Binding BestKnownTitle}" Foreground="LimeGreen" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" ToolTip="Green dashed square: reference network from the sorting catalog." />
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Margin="0,10,0,0" ToolTip="Blue marks the least visited cells. Colors progress through cyan, green, yellow and orange to red for the most visited cells. Equal counts across the graph use blue.">
                                    <TextBlock Text="Plot count (log scale)" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Rectangle Width="72" Height="10" VerticalAlignment="Center" Fill="{x:Static controls:EvolutionPlot.FrequencyLegend}" />
                                        <TextBlock Text="{Binding Visits.Maximum, StringFormat='Max {0:N0}'}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="Clear" Command="{Binding ClearGraphCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        AutomationProperties.Name="Clear graph" ToolTip="Clear the plotted history" />
                            </StackPanel>
                        </ScrollViewer>
                        <Canvas Grid.Column="1" x:Name="PlotHost">
                            <ScrollViewer x:Name="PlotScroll" Width="{Binding ActualWidth, ElementName=PlotHost}" Height="{Binding ActualHeight, ElementName=PlotHost}"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                          ScrollChanged="CenterPlotOnResize">
                                <controls:EvolutionPlot Visits="{Binding Visits}" BestPosition="{Binding BestPosition}" BestKnownNetworks="{Binding BestKnownNetworks}"
                                                        ViewportWidth="{Binding ViewportWidth, ElementName=PlotScroll}"
                                                        HorizontalOffset="{Binding HorizontalOffset, ElementName=PlotScroll}"
                                                        AutomationProperties.Name="Evolution lattice, CE count horizontally and stage count vertically, equally scaled" />
                            </ScrollViewer>
                        </Canvas>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="4" Text="SGD ranks by failures, then by size (CEs + 1.1 × stages). Graph Best is the smallest score among sorters with zero failures on their tested inputs." Foreground="#9FBECC" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
