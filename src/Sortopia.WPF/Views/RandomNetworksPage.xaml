<UserControl x:Class="Sortopia.WPF.Views.RandomNetworksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sortopia.WPF.Controls"
             AutomationProperties.Name="Random Networks page">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DBE8EF" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource NetworkComboBoxStyle}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource NetworkTextBoxStyle}" />
        <Style x:Key="InlineError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4CA7F" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="#102B3B" Margin="0">
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Height="{Binding ViewportHeight, ElementName=PageScroll}" MinHeight="660">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="← _Back to Sortopia" Command="{Binding ReturnHomeCommand}"
                        Margin="16,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Back to Sortopia" />
                <StackPanel>
                    <TextBlock Text="Random Networks" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,6">
                <WrapPanel IsEnabled="{Binding CanEdit}">
                    <StackPanel Margin="0,0,10,5">
                        <Label Content="_Method" Target="{Binding ElementName=MethodPicker}" Foreground="#9FBECC" Padding="0,0,0,3" />
                        <ComboBox x:Name="MethodPicker" Width="96" ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" AutomationProperties.Name="Generation method" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,5">
                        <Label Content="_Channels" Target="{Binding ElementName=ChannelPicker}" Foreground="#9FBECC" Padding="0,0,0,3" />
                        <ComboBox x:Name="ChannelPicker" Width="78" ItemsSource="{Binding ChannelCounts}" SelectedItem="{Binding ChannelCount}" ToolTip="{Binding WidthHint}" AutomationProperties.Name="Channel count" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,5">
                        <Label Content="{Binding CountLabel}" Target="{Binding ElementName=SizeInput}" Foreground="#9FBECC" Padding="0,0,0,3" />
                        <TextBox x:Name="SizeInput" Width="135" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Network size" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,5">
                        <Label Content="Random _seed" Target="{Binding ElementName=SeedInput}" Foreground="#9FBECC" Padding="0,0,0,3" />
                        <Grid Width="132">
                            <TextBox x:Name="SeedInput" Padding="8,4,34,4" Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Random seed" ToolTip="Same seed and settings reproduce the same network." />
                            <Button Command="{Binding NewSeedCommand}" Width="26" Height="24" MinHeight="0" Padding="0" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    ToolTip="New random seed" AutomationProperties.Name="New random seed" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Surface" Background="Transparent" CornerRadius="4" BorderBrush="Transparent" BorderThickness="1">
                                            <Path Data="M 15 6 A 6 6 0 1 0 15 12 M 15 2 L 15 6 L 11 6" Stroke="#9EDAD6" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#315D6B" /></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C6570" /></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F6CE83" /></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,5">
                        <Label Content="Test inputs / all" Target="{Binding ElementName=SampleInput}" Foreground="#9FBECC" Padding="0,0,0,3" />
                        <TextBox x:Name="SampleInput" Width="110" Text="{Binding SamplesText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding TestHint}" AutomationProperties.Name="Test sample count or all" />
                    </StackPanel>
                    <Button Content="Generate" Command="{Binding GenerateCommand}" VerticalAlignment="Bottom" Margin="0,0,6,5" AutomationProperties.Name="Generate random network" />
                </WrapPanel>
                <TextBlock Text="{Binding InputError}" Style="{StaticResource InlineError}" />
                <TextBlock Text="{Binding TestInputError}" Style="{StaticResource InlineError}" />
                <WrapPanel Margin="0,0,0,5" IsEnabled="{Binding CanInteract}">
                    <Button Content="Test" Command="{Binding TestCommand}" AutomationProperties.Name="Test generated network" />
                    <Button Content="Cancel" Command="{Binding CancelTestCommand}" AutomationProperties.Name="Cancel network test" />
                    <Button Content="Remove unused" Command="{Binding RemoveUnusedCesCommand}" ToolTip="{Binding RemoveUnusedHint}" ToolTipService.ShowOnDisabled="True" />
                    <Button Content="Compact stages" Command="{Binding CompactStagesCommand}" ToolTip="Run Test, then Remove unused before compacting the remaining CEs." ToolTipService.ShowOnDisabled="True" />
                    <Button Content="Shuffle input" Command="{Binding ShuffleCommand}" />
                    <CheckBox Content="0–1 rule" IsChecked="{Binding UseZeroOneRule}" Foreground="#DBE8EF" VerticalAlignment="Center" Margin="4,0,0,0" AutomationProperties.Name="Use 0–1 rule" />
                </WrapPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding NetworkSummary}" Foreground="#9FBECC" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Status}" Foreground="#F4CA7F" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </StackPanel>

            <Border Grid.Row="2" Background="#1B3E50" CornerRadius="10" Padding="8" Margin="0,0,0,6">
                <WrapPanel VerticalAlignment="Center" IsEnabled="{Binding CanInteract}">
                    <Button Content="Reset" Command="{Binding ResetCommand}" AutomationProperties.Name="Reset playback" />
                    <Button Content="Previous" Command="{Binding PreviousCommand}" AutomationProperties.Name="Previous step" />
                    <Button Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" MinWidth="72"
                            Background="#2C6570" AutomationProperties.Name="Play or pause" />
                    <Button Content="Next" Command="{Binding NextCommand}" AutomationProperties.Name="Next step" />
                    <ComboBox Width="126" ItemsSource="{Binding StepModes}" SelectedIndex="{Binding StepMode}"
                              Margin="8,2,18,2" AutomationProperties.Name="Step mode" ToolTip="Step through individual comparators or complete stages" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,16,6">
                        <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider Width="80" Minimum="0.25" Maximum="3" Value="{Binding Speed}" SmallChange="0.25"
                                AutomationProperties.Name="Playback speed" ToolTip="Playback speed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,6">
                        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider Width="80" Minimum="0.4" Maximum="1.5" Value="{Binding Zoom}" SmallChange="0.1"
                                AutomationProperties.Name="Diagram zoom" ToolTip="Zoom the network; scroll to see larger networks" />
                    </StackPanel>
                    <CheckBox Content="Follow" IsChecked="{Binding FollowPlayback}" Foreground="#DBE8EF"
                              VerticalAlignment="Center" Margin="14,6,0,6" AutomationProperties.Name="Follow playback"
                              ToolTip="Keep the animated values in view horizontally" />
                </WrapPanel>
            </Border>

            <Border Grid.Row="3" BorderBrush="#345464" BorderThickness="1" CornerRadius="8" Background="#102B3B">
                <Grid>
                <ScrollViewer x:Name="DiagramViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Padding="12" AutomationProperties.Name="Network diagram viewport">
                    <controls:NetworkDiagram x:Name="Diagram" Trace="{Binding DisplayTrace}" Compaction="{Binding Compaction}" Usage="{Binding DisplayedUsage}" UseZeroOneRule="{Binding UseZeroOneRule}" Position="{Binding Position}" ByStage="{Binding ByStage}" Zoom="{Binding Zoom}"
                                             HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Margin="0,6,0,0" IsEnabled="{Binding CanInteract}">
                <CheckBox Content="Color CEs by test usage" IsChecked="{Binding ShowCeUsage}" Foreground="#DBE8EF" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding UsageBands}" Margin="0,0,0,6" AutomationProperties.Name="CE swap percentage legend">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Fill}" CornerRadius="3" Padding="7,5" MinWidth="51" Margin="0,0,3,3" ToolTip="{Binding Description}">
                                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Margin="16,0,0,0" MinWidth="132" TextAlignment="Right" />
                    <Slider Minimum="0" Maximum="{Binding StepCount}" Value="{Binding SeekPosition, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                            AutomationProperties.Name="Playback position" ToolTip="Seek to any recorded step" />
                </DockPanel>
                <TextBlock Text="{Binding CurrentValuesText}" FontFamily="Consolas" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
                <Expander Header="Usage details" Foreground="#9FBECC" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding GenerationLabel}" Foreground="#9FBECC" />
                        <TextBlock Text="{Binding UsageSummary}" TextWrapping="Wrap" />

                    </StackPanel>
                </Expander>
            </StackPanel>
        </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
