<UserControl x:Class="Sortopia.WPF.Views.SortableTestsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  AutomationProperties.Name="Project runs">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
    <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,5"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource NetworkTextBoxStyle}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource NetworkComboBoxStyle}"/>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,4"/><Setter Property="Foreground" Value="#BBD5E1"/>
    </Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#173C4E"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#416777"/></Style>
  </UserControl.Resources>
  <DockPanel Background="#102B3B" LastChildFill="True">
    <DockPanel DockPanel.Dock="Top" Margin="20,14">
      <Button DockPanel.Dock="Right" Content="← Back to Sortopia" Command="{Binding Back}"/>
      <StackPanel>
        <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="White" Text="Project runs"/>
        <TextBlock Foreground="#BBD5E1" Text="{Binding LibraryPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LibraryPath}"/>
      </StackPanel>
    </DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Foreground="#A8DFD6" Margin="20,8" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <TabControl Margin="16,0" SelectedIndex="{Binding Tab}" Background="#102B3B" BorderBrush="#355869">
      <TabItem Header="Sortable tests">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <StackPanel IsEnabled="{Binding CanEdit}">
              <TextBlock Style="{StaticResource Caption}" Text="New sortable-tests DirectRun"/>
              <TextBox Text="{Binding RunName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Run name"/>
              <TextBlock Style="{StaticResource Caption}" Text="Choose a construction and add each dataset you want to generate."/>
              <WrapPanel>
                <ComboBox Width="96" ItemsSource="{Binding Generators}" SelectedItem="{Binding Generator}" AutomationProperties.Name="Generator"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsMerge, Converter={StaticResource VisibleWhen}}">
                  <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Foreground="White" Text="Channels"/>
                  <TextBox Width="52" Text="{Binding Channels, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Channels"/>
                  <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Foreground="White" Text="Ways"/>
                  <TextBox Width="52" Margin="0,0,8,0" Text="{Binding Ways, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Merge ways"/>
                </StackPanel>
                <ComboBox Width="265" Margin="8,0" Visibility="{Binding IsPrefix, Converter={StaticResource VisibleWhen}}" ItemsSource="{Binding Prefixes}" SelectedItem="{Binding Prefix}" AutomationProperties.Name="Prefix network"/>
                <Button Command="{Binding Add}" Content="Add dataset"/>
              </WrapPanel>
              <TextBlock Style="{StaticResource Caption}" Text="Planned outputs"/>
              <ListBox MinHeight="80" MaxHeight="220" ItemsSource="{Binding Plan}" SelectedItem="{Binding SelectedRecipe}" AutomationProperties.Name="Planned outputs"/>
              <Button Margin="0,6" HorizontalAlignment="Left" Content="Remove selected" Command="{Binding Remove}"/>
              <WrapPanel>
                <Button Content="Save definition" Command="{Binding SaveDefinition}"/>
                <Button Content="Save and run" Command="{Binding Execute}"/>
              </WrapPanel>
              <TextBlock Style="{StaticResource Caption}" Text="Saved definition"/>
              <ComboBox ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}" AutomationProperties.Name="Saved DirectRun definition"/>
              <ItemsControl Margin="4,6" ItemsSource="{Binding SelectedDefinition.Datasets}">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="#BBD5E1" Text="{Binding Recipe}"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <CheckBox Foreground="White" Margin="0,10" Content="Publish an “All outputs” manifest on completion" IsChecked="{Binding PublishAll}"/>
            </StackPanel>
            <WrapPanel>
              <Button Content="Generate runParameter files" Command="{Binding GenerateParameters}"/>
              <Button Content="Execute saved parameters" Command="{Binding ExecuteParameters}"/>
              <Button Content="Cancel" Command="{Binding Cancel}"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Manifest designer">
        <TabControl SelectedIndex="{Binding DesignerTab}" Background="#102B3B" BorderBrush="#355869">
          <TabItem Header="Sortopia runs">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Style="{StaticResource Caption}" Text="Completed run"/>
            <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" AutomationProperties.Name="Completed run"/>
            <TextBlock Style="{StaticResource Caption}" Text="Published manifests · select one to inspect its slots or make a new version"/>
            <ComboBox ItemsSource="{Binding Manifests}" SelectedItem="{Binding SelectedManifest}" AutomationProperties.Name="Published manifests"/>
            <TextBlock Style="{StaticResource Caption}" Text="Select outputs and assign slot indices within each output type."/>
            <ItemsControl ItemsSource="{Binding Slots}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="#173C4E" Margin="0,1" Padding="8,4" CornerRadius="4">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding Included}" AutomationProperties.Name="Include output"/>
                    <TextBox DockPanel.Dock="Left" Width="55" Margin="8,0" IsEnabled="{Binding Included}" Text="{Binding Slot, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Slot index"/>
                    <TextBlock VerticalAlignment="Center" Foreground="White" Text="{Binding Output}" TextWrapping="Wrap"/>
                  </DockPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Caption}" Text="Manifest name"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding Publish}" Content="Publish new manifest"/>
              <TextBox Text="{Binding ManifestName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Manifest name"/>
            </DockPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
          <TabItem Header="GeneSort inventory">
            <DockPanel DataContext="{Binding CsvInventory}" Margin="14" LastChildFill="True">
              <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                  <Button Content="Open GeneSort project…" Command="{Binding Choose}"/>
                  <Button Content="Refresh from Results" Command="{Binding Refresh}"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding InventoryPath}" TextWrapping="Wrap"/>
                <TextBlock Foreground="White" Margin="0,0,0,8" TextWrapping="Wrap"
                  Text="Check the Results to include. Edit Order to place them within each output type. The saved indices start at zero for each type."/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Style="{StaticResource Caption}" Text="Manifest filename"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Save CSV manifest" Command="{Binding Publish}"/>
                  <TextBox Text="{Binding ManifestName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="CSV manifest name"/>
                </DockPanel>
                <TextBlock Foreground="#A8DFD6" Margin="0,6" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
              <DataGrid ItemsSource="{Binding Rows}" AutomationProperties.Name="GeneSort inventory rows"
                CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" HeadersVisibility="Column"
                GridLinesVisibility="Horizontal" RowBackground="#173C4E" AlternatingRowBackground="#1E475A"
                Foreground="White" Background="#102B3B" BorderBrush="#355869" HorizontalGridLinesBrush="#355869"
                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#244C60"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="6,4"/></Style>
                </DataGrid.Resources>
              </DataGrid>
            </DockPanel>
          </TabItem>
        </TabControl>
      </TabItem>
      <TabItem Header="Sorter model set">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14" IsEnabled="{Binding CanEdit}">
            <TextBlock Style="{StaticResource Caption}" Text="Run name"/>
            <TextBox Text="{Binding ModelRunName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Model run name"/>
            <WrapPanel Margin="0,4">
              <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Caption}" Text="Channels"/><TextBox Width="78" Text="{Binding ModelChannels, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Model channels"/></StackPanel>
              <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Caption}" Text="Stages per model"/><TextBox Width="110" Text="{Binding ModelStages, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Model stages"/></StackPanel>
              <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Caption}" Text="Model count"/><TextBox Width="85" Text="{Binding ModelCount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Model count"/></StackPanel>
              <StackPanel><TextBlock Style="{StaticResource Caption}" Text="First model index"/><TextBox Width="110" Text="{Binding ModelFirstIndex, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="First model index"/></StackPanel>
            </WrapPanel>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Each mssi model has random comparator stages. The same settings and index range reproduce the same models."/>
            <Button HorizontalAlignment="Left" Content="Generate set and manifest" Command="{Binding GenerateModels}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Sorter evaluation">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <StackPanel IsEnabled="{Binding CanEdit}">
              <TextBlock Style="{StaticResource Caption}" Text="Run name"/>
              <TextBox Text="{Binding EvalRunName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Evaluation run name"/>
              <TextBlock Style="{StaticResource Caption}" Text="Model manifest and slot"/>
              <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding ModelsInput}" AutomationProperties.Name="Model manifest slot"/>
              <TextBlock Style="{StaticResource Caption}" Text="Sortable tests manifest and slot"/>
              <ComboBox ItemsSource="{Binding TestChoices}" SelectedItem="{Binding TestsInput}" AutomationProperties.Name="Tests manifest slot"/>
              <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Test each model against every input in the selected dataset. Both inputs must have the same channel count."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"><Button Content="Evaluate models" Command="{Binding EvaluateModels}"/><Button Content="Cancel" Command="{Binding Cancel}"/></StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
