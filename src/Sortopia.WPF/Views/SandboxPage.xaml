<UserControl x:Class="Sortopia.WPF.Views.SandboxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sortopia.WPF.Views"
             FontFamily="Segoe UI" UseLayoutRounding="True"
             AutomationProperties.Name="Sandbox page" Foreground="{DynamicResource Workspace.TextPrimary}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sortopia.WPF;component/Styles/WorkspaceTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{StaticResource Workspace.Canvas}" Padding="16">
        <views:SgdPage x:Name="Workspace" DataContext="{Binding Workspace}" />
    </Border>
</UserControl>
