<Window x:Class="Sortopia.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Sortopia.WPF.ViewModels"
        xmlns:views="clr-namespace:Sortopia.WPF.Views"
        Title="Sortopia"
        Icon="Assets/sortopia.ico"
        Width="1100" Height="780"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#173C4E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.DataContext>
        <viewModels:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:HomePageViewModel}">
            <views:HomePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SandboxPageViewModel}">
            <views:SandboxPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:NetworksPageViewModel}">
            <views:NetworksPage />
        </DataTemplate>
    </Window.Resources>
    <ContentControl Content="{Binding CurrentPage}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
</Window>
